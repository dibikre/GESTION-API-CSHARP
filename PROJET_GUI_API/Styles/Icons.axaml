<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icônes filaires simples sur grille 16x16 (trait 1,5 px) -->
    <StreamGeometry x:Key="IconSend">M 2.5,8 L 13.5,8 M 9,3.5 L 13.5,8 L 9,12.5</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M 4,4 L 12,4 L 12,12 L 4,12 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M 8,3 L 8,13 M 3,8 L 13,8</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M 3,4.5 L 13,4.5 M 6,4.5 L 6,3 L 10,3 L 10,4.5 M 4.5,4.5 L 5,13 L 11,13 L 11.5,4.5 M 6.8,7 L 6.8,10.8 M 9.2,7 L 9.2,10.8</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M 6,4 L 10,8 L 6,12</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDown">M 4,6 L 8,10 L 12,6</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M 2.5,4.5 L 6.5,4.5 L 8,6 L 13.5,6 L 13.5,12.5 L 2.5,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconWarning">M 8,2.5 L 14,13 L 2,13 Z M 8,6.5 L 8,9.5 M 8,11.2 L 8,11.6</StreamGeometry>
    <StreamGeometry x:Key="IconInfo">M 8,2 A 6,6 0 1 1 7.99,2 Z M 8,7 L 8,11.5 M 8,4.8 L 8,5.1</StreamGeometry>
    <StreamGeometry x:Key="IconArrowUp">M 4,10 L 8,5.5 L 12,10</StreamGeometry>
    <StreamGeometry x:Key="IconArrowDown">M 4,6 L 8,10.5 L 12,6</StreamGeometry>
    <StreamGeometry x:Key="IconCopy">M 5.5,5.5 L 13,5.5 L 13,13 L 5.5,13 Z M 3,10.5 L 3,3 L 10.5,3</StreamGeometry>
    <StreamGeometry x:Key="IconExpand">M 9.5,3 L 13,3 L 13,6.5 M 13,3 L 8.8,7.2 M 6.5,13 L 3,13 L 3,9.5 M 3,13 L 7.2,8.8</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M 4,4 L 12,12 M 12,4 L 4,12</StreamGeometry>
    <StreamGeometry x:Key="IconCode">M 5.5,4.5 L 2,8 L 5.5,11.5 M 10.5,4.5 L 14,8 L 10.5,11.5 M 9,3 L 7,13</StreamGeometry>

</ResourceDictionary>
