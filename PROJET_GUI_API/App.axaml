<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ApiTester.App"
             xmlns:local="using:ApiTester"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Tokens.axaml" />
                <ResourceInclude Source="/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light"
                                       Accent="#2563EB"
                                       RegionColor="#F6F7F9"
                                       ErrorText="#D13438" />
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#4F8CFF"
                                       RegionColor="#14161A"
                                       ErrorText="#E5484D" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Styles/Controls.axaml" />
    </Application.Styles>

</Application>