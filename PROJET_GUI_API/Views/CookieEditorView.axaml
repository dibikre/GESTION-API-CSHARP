<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiTester.ViewModels"
             xmlns:models="using:ApiTester.Models"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="520"
             x:Class="ApiTester.Views.CookieEditorView"
             x:Name="CookieRoot"
             x:DataType="vm:CookieEditorViewModel">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <!-- En-tête : titre + compteur + bascule Tableau/Texte + Copier + Fermer -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="Éditeur de cookies"
                           FontSize="{DynamicResource FontSizeBase}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" />
                <Border Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="{DynamicResource BadgeCornerRadius}"
                        Padding="7,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CookieCountText}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
            </StackPanel>

            <!-- Bascule Tableau / Texte -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                <Button Classes.primary="{Binding IsTableMode}"
                        Classes.secondary="{Binding IsTextMode}"
                        Content="Tableau"
                        Command="{Binding SwitchToTableCommand}"
                        AutomationProperties.Name="Afficher les cookies en tableau" />
                <Button Classes.primary="{Binding IsTextMode}"
                        Classes.secondary="{Binding IsTableMode}"
                        Content="Texte"
                        Command="{Binding SwitchToTextCommand}"
                        AutomationProperties.Name="Afficher les cookies en texte brut" />
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="ghost"
                    Command="{Binding CopyCommand}"
                    AutomationProperties.Name="Copier l'en-tête Cookie">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="iconStroke" Data="{StaticResource IconCopy}" />
                    <TextBlock Text="Copier" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Classes="icon"
                    Command="{Binding CloseCommand}"
                    ToolTip.Tip="Fermer (Échap)"
                    AutomationProperties.Name="Fermer l'éditeur de cookies">
                <Path Classes="iconStroke" Data="{StaticResource IconClose}" />
            </Button>
        </Grid>

        <!-- Corps : Mode Tableau -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsTableMode}"
              RowDefinitions="Auto,*">
            <!-- En-têtes de colonnes -->
            <Border Grid.Row="0"
                    IsVisible="{Binding #CookieItemsList.ItemCount, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,12,4">
                <Grid ColumnDefinitions="36,*,2*,28" ColumnSpacing="6">
                    <TextBlock Grid.Column="0"
                               Text="Actif"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Nom du cookie"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="6,0,0,0" />
                    <TextBlock Grid.Column="2"
                               Text="Valeur"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="6,0,0,0" />
                </Grid>
            </Border>

            <!-- État vide -->
            <StackPanel Grid.Row="1"
                        IsVisible="{Binding #CookieItemsList.ItemCount, Converter={x:Static conv:CollectionCountConverters.IsZero}}"
                        Spacing="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Aucun cookie défini. Clique sur « + Ajouter un cookie » ou bascule en mode Texte."
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Classes="ghost"
                        HorizontalAlignment="Center"
                        Command="{Binding AddCookieCommand}"
                        AutomationProperties.Name="Ajouter un cookie">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="iconStroke" Data="{StaticResource IconPlus}" />
                        <TextBlock Text="Ajouter un cookie" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Liste des cookies en tableau -->
            <ScrollViewer Grid.Row="1"
                          IsVisible="{Binding #CookieItemsList.ItemCount, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                          AllowAutoHide="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,4" Spacing="0">
                    <ItemsControl x:Name="CookieItemsList" ItemsSource="{Binding Cookies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CookiePairItem">
                                <Border Classes="kvRow"
                                        Height="30"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="36,*,2*,28" ColumnSpacing="6">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Activer le cookie" />

                                        <TextBox Grid.Column="1"
                                                 Classes="kvCell mono"
                                                 Text="{Binding Name}"
                                                 PlaceholderText="Nom du cookie"
                                                 ToolTip.Tip="{Binding Name, Converter={x:Static conv:StringDisplayConverters.EmptyToNull}}"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Nom du cookie" />

                                        <TextBox Grid.Column="2"
                                                 Classes="kvCell mono"
                                                 Text="{Binding Value}"
                                                 PlaceholderText="Valeur (accepte {{variables}})"
                                                 ToolTip.Tip="{Binding Value, Converter={x:Static conv:StringDisplayConverters.EmptyToNull}}"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Valeur du cookie" />

                                        <Button Grid.Column="3"
                                                Classes="icon danger kvDelete"
                                                Command="{Binding #CookieRoot.ViewModel.RemoveCookieCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Supprimer ce cookie"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Supprimer le cookie">
                                            <Path Classes="iconStroke" Data="{StaticResource IconTrash}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="ghost"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,2"
                            Command="{Binding AddCookieCommand}"
                            AutomationProperties.Name="Ajouter un cookie">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="iconStroke" Data="{StaticResource IconPlus}" />
                            <TextBlock Text="Ajouter un cookie" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Corps : Mode Texte -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsTextMode}"
              RowDefinitions="*,Auto"
              RowSpacing="6">
            <TextBox x:Name="CookieTextBox"
                     Grid.Row="0"
                     Classes="mono"
                     Text="{Binding TextValue, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSizeMono}"
                     PlaceholderText="nom1=valeur1; nom2=valeur2"
                     ScrollViewer.AllowAutoHide="False"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Édition texte brut des cookies" />
            <TextBlock Grid.Row="1"
                       Text="Sépare chaque cookie par « ; » (ou un par ligne). Accepte {{variables}} et [[listes]]."
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFaintBrush}"
                       TextWrapping="Wrap" />
        </Grid>

        <!-- Pied : Annuler / Enregistrer -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0"
                       Text="Les cookies désactivés en mode Tableau ne sont pas inclus dans l'en-tête enregistré."
                       IsVisible="{Binding IsTableMode}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFaintBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Classes="secondary"
                        Content="Annuler"
                        Command="{Binding CloseCommand}"
                        AutomationProperties.Name="Annuler les modifications des cookies" />
                <Button Classes="primary"
                        Content="Enregistrer"
                        Command="{Binding SaveAndCloseCommand}"
                        AutomationProperties.Name="Enregistrer les cookies" />
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
