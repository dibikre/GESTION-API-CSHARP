<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiTester.ViewModels"
             xmlns:models="using:ApiTester.Models"
             xmlns:services="using:ApiTester.Services"
             xmlns:views="using:ApiTester.Views"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="520"
             x:Class="ApiTester.Views.ExtractionConditionsView"
             x:Name="ConditionsRoot"
             x:DataType="vm:ExtractionConditionsViewModel">

    <Border Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            Padding="10">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
            <!-- Barre supérieure : titre + bascule Guidé / Manuel + Réinitialiser -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Conditions d'affinage"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <Border IsVisible="{Binding HasActiveConditionsBadge}"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="{DynamicResource BadgeCornerRadius}"
                            Padding="6,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveConditionsCount}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes.primary="{Binding IsGuidedMode}"
                            Classes.secondary="{Binding IsManualMode}"
                            Content="Guidé"
                            Height="24"
                            MinHeight="24"
                            Padding="8,0"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Command="{Binding SwitchToGuidedCommand}"
                            AutomationProperties.Name="Mode guidé des conditions" />
                    <Button Classes.primary="{Binding IsManualMode}"
                            Classes.secondary="{Binding IsGuidedMode}"
                            Content="Manuel"
                            Height="24"
                            MinHeight="24"
                            Padding="8,0"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Command="{Binding SwitchToManualCommand}"
                            AutomationProperties.Name="Mode manuel des conditions" />
                </StackPanel>

                <Button Grid.Column="2"
                        Classes="ghost"
                        Content="Réinitialiser"
                        Height="24"
                        MinHeight="24"
                        Padding="8,0"
                        FontSize="{DynamicResource FontSizeCaption}"
                        Command="{Binding ClearConditionsCommand}"
                        ToolTip.Tip="Supprimer toutes les conditions"
                        AutomationProperties.Name="Réinitialiser les conditions" />
            </Grid>

            <!-- Barre de modèles rapides -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="8,6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0"
                               Text="Modèle rapide"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{x:Static vm:ExtractionConditionsViewModel.PresetOptions}"
                              SelectedItem="{Binding SelectedPreset}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Modèle d'extraction rapide">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:ExtractionConditionPreset">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="Appliquer modèle"
                            Height="26"
                            MinHeight="26"
                            Padding="10,0"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Command="{Binding ApplyPresetCommand}"
                            ToolTip.Tip="Ajouter le modèle sélectionné aux conditions"
                            AutomationProperties.Name="Appliquer le modèle rapide" />
                </Grid>
            </Border>

            <!-- Assistant contextuel depuis une sélection dans la liste de gauche -->
            <Border Grid.Row="2"
                    IsVisible="{Binding HasSelectionSuggestion}"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="8,6">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding SelectionSummaryText}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="primary"
                                Content="Extraire ce type"
                                Height="24"
                                MinHeight="24"
                                Padding="8,0"
                                Margin="0,0,6,2"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Command="{Binding ApplySelectionTypeCommand}"
                                ToolTip.Tip="Créer une règle Regex capturant toutes les valeurs du même type (ex. Hex long, UUID, chiffres)"
                                AutomationProperties.Name="Extraire le type détecté depuis la sélection" />
                        <Button Classes="secondary"
                                Content="Par contexte"
                                Height="24"
                                MinHeight="24"
                                Padding="8,0"
                                Margin="0,0,6,2"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Command="{Binding ApplySelectionContextCommand}"
                                ToolTip.Tip="Créer une règle Regex ancrée par les délimiteurs situés juste avant et après la sélection"
                                AutomationProperties.Name="Extraire par contexte autour de la sélection" />
                        <Button Classes="ghost"
                                Content="Filtrer contient"
                                Height="24"
                                MinHeight="24"
                                Padding="8,0"
                                Margin="0,0,0,2"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Command="{Binding ApplySelectionContainsCommand}"
                                ToolTip.Tip="Ne garder que les lignes contenant le texte sélectionné"
                                AutomationProperties.Name="Filtrer les lignes contenant la sélection" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Mode Guidé -->
            <Grid Grid.Row="3"
                  IsVisible="{Binding IsGuidedMode}"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="8">
                <!-- Options globales : combinateur ET/OU + déduplication -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Text="Logique"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{x:Static vm:ExtractionConditionsViewModel.MatchModeOptions}"
                                  SelectedItem="{Binding MatchMode}"
                                  MinWidth="140"
                                  AutomationProperties.Name="Mode de combinaison des conditions">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ExtractionConditionMatchMode">
                                    <TextBlock Text="{Binding Converter={x:Static conv:ExtractionConditionMatchModeConverters.ToLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding DeduplicateList}"
                              Content="Sans doublons"
                              Margin="0,0,0,4"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Conserver uniquement la première occurrence de chaque valeur"
                              AutomationProperties.Name="Supprimer les doublons" />
                </WrapPanel>

                <!-- Liste des règles ou état vide -->
                <Grid Grid.Row="1">
                    <StackPanel IsVisible="{Binding #ConditionItems.ItemCount, Converter={x:Static conv:CollectionCountConverters.IsZero}}"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Aucune condition définie. Sélectionne un exemple à gauche, choisis un modèle ci-dessus, ou crée une condition simple ou « Si ... Alors ... »."
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Classes="secondary"
                                    Margin="0,0,6,4"
                                    Command="{Binding AddConditionCommand}"
                                    AutomationProperties.Name="Ajouter une condition">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="iconStroke" Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="Ajouter une condition" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="secondary"
                                    Margin="0,0,0,4"
                                    Command="{Binding AddConditionalRuleCommand}"
                                    AutomationProperties.Name="Ajouter une règle Si Alors">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="iconStroke" Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="Ajouter un « Si ... Alors ... »" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <ScrollViewer IsVisible="{Binding #ConditionItems.ItemCount, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                  AllowAutoHide="False"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="6" Margin="0,0,8,4">
                            <ItemsControl x:Name="ConditionItems" ItemsSource="{Binding Conditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChainExtractionCondition">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,6"
                                                Margin="0,0,0,4">
                                            <StackPanel Spacing="6">
                                                <!-- En-tête de la règle -->
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled}"
                                                              ToolTip.Tip="Activer ou désactiver cette règle"
                                                              VerticalAlignment="Center"
                                                              AutomationProperties.Name="Activer la règle" />

                                                    <Button Grid.Column="1"
                                                            Classes.primary="{Binding IsConditional}"
                                                            Classes.secondary="{Binding IsSimpleRule}"
                                                            Content="Si"
                                                            Height="24"
                                                            MinHeight="24"
                                                            Padding="7,0"
                                                            FontSize="{DynamicResource FontSizeCaption}"
                                                            Command="{Binding #ConditionsRoot.ViewModel.ToggleConditionalRuleCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Basculer entre règle simple et règle conditionnelle Si / Alors / Sinon"
                                                            AutomationProperties.Name="Basculer en mode Si Alors Sinon" />

                                                    <Panel Grid.Column="2">
                                                        <ComboBox IsVisible="{Binding IsSimpleRule}"
                                                                  ItemsSource="{x:Static vm:ExtractionConditionsViewModel.OperatorOptions}"
                                                                  SelectedItem="{Binding Operator}"
                                                                  HorizontalAlignment="Stretch"
                                                                  AutomationProperties.Name="Opérateur de condition">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:ExtractionConditionOperator">
                                                                    <TextBlock Text="{Binding Converter={x:Static conv:ExtractionConditionOperatorConverters.ToLabel}}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <Grid IsVisible="{Binding IsConditional}"
                                                              ColumnDefinitions="Auto,*"
                                                              ColumnSpacing="6">
                                                            <Border Grid.Column="0"
                                                                    Background="{DynamicResource AccentSoftBrush}"
                                                                    CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                                    Padding="6,2"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="SI"
                                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{x:Static vm:ExtractionConditionsViewModel.FilterOperatorOptions}"
                                                                      SelectedItem="{Binding Operator}"
                                                                      HorizontalAlignment="Stretch"
                                                                      AutomationProperties.Name="Test de la condition Si">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:ExtractionConditionOperator">
                                                                        <TextBlock Text="{Binding Converter={x:Static conv:ExtractionConditionOperatorConverters.ToLabel}}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </Grid>
                                                    </Panel>

                                                    <Button Grid.Column="3"
                                                            Classes="icon"
                                                            Command="{Binding #ConditionsRoot.ViewModel.MoveConditionUpCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Monter la condition"
                                                            AutomationProperties.Name="Monter la condition">
                                                        <Path Classes="iconStroke" Data="{StaticResource IconArrowUp}" />
                                                    </Button>

                                                    <Button Grid.Column="4"
                                                            Classes="icon"
                                                            Command="{Binding #ConditionsRoot.ViewModel.MoveConditionDownCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Descendre la condition"
                                                            AutomationProperties.Name="Descendre la condition">
                                                        <Path Classes="iconStroke" Data="{StaticResource IconArrowDown}" />
                                                    </Button>

                                                    <Button Grid.Column="5"
                                                            Classes="icon danger"
                                                            Command="{Binding #ConditionsRoot.ViewModel.RemoveConditionCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Supprimer cette condition"
                                                            AutomationProperties.Name="Supprimer la condition">
                                                        <Path Classes="iconStroke" Data="{StaticResource IconTrash}" />
                                                    </Button>
                                                </Grid>

                                                <TextBox Classes="mono"
                                                         IsVisible="{Binding RequiresValue}"
                                                         Text="{Binding Value}"
                                                         PlaceholderText="{Binding ValuePlaceholder}"
                                                         AutomationProperties.Name="Valeur ou motif de la condition" />

                                                <Grid IsVisible="{Binding HasReplacementRow}"
                                                      ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="6">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding ReplacementLabel}"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1"
                                                             Classes="mono"
                                                             Text="{Binding Replacement}"
                                                             PlaceholderText="{Binding ReplacementPlaceholder}"
                                                             AutomationProperties.Name="Seconde valeur de la condition" />
                                                </Grid>

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel IsVisible="{Binding IsRegexExtractAny}"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                Margin="0,0,12,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="Groupe"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <NumericUpDown Value="{Binding RegexGroup, Converter={x:Static conv:RegexGroupToDecimalConverter.Instance}, Mode=TwoWay}"
                                                                       Minimum="0"
                                                                       Maximum="99"
                                                                       Increment="1"
                                                                       FormatString="0"
                                                                       ShowButtonSpinner="False"
                                                                       Width="54"
                                                                       ToolTip.Tip="0 = correspondance complète ; 1, 2... = groupe entre parenthèses (...)"
                                                                       AutomationProperties.Name="Index du groupe Regex de la condition" />
                                                    </StackPanel>

                                                    <StackPanel IsVisible="{Binding IsSplitPart}"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                Margin="0,0,12,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="Index"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <NumericUpDown Value="{Binding SegmentIndex, Converter={x:Static conv:SegmentIndexToDecimalConverter.Instance}, Mode=TwoWay}"
                                                                       Minimum="-99"
                                                                       Maximum="99"
                                                                       Increment="1"
                                                                       FormatString="0"
                                                                       ShowButtonSpinner="False"
                                                                       Width="58"
                                                                       ToolTip.Tip="0 = premier morceau, 1 = deuxième, -1 = dernier morceau"
                                                                       AutomationProperties.Name="Index du segment après découpage" />
                                                    </StackPanel>

                                                    <CheckBox IsVisible="{Binding SupportsIgnoreCase}"
                                                              IsChecked="{Binding IgnoreCase}"
                                                              Content="Ignorer la casse"
                                                              VerticalAlignment="Center"
                                                              AutomationProperties.Name="Ignorer la casse" />
                                                </WrapPanel>

                                                <!-- Branches ALORS / SINON lorsque la règle est conditionnelle -->
                                                <StackPanel IsVisible="{Binding IsConditional}" Spacing="6">
                                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="8,6">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="ALORS"
                                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                            <Panel>
                                                                <views:ConditionalBranchEditor DataContext="{Binding ThenBranch}" />
                                                            </Panel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="8,6">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="SINON"
                                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <Panel>
                                                                <views:ConditionalBranchEditor DataContext="{Binding ElseBranch}" />
                                                            </Panel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="ghost"
                                        Margin="0,0,6,0"
                                        Command="{Binding AddConditionCommand}"
                                        AutomationProperties.Name="Ajouter une condition">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="iconStroke" Data="{StaticResource IconPlus}" />
                                        <TextBlock Text="Ajouter une condition" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost"
                                        Command="{Binding AddConditionalRuleCommand}"
                                        AutomationProperties.Name="Ajouter une règle Si Alors">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="iconStroke" Data="{StaticResource IconPlus}" />
                                        <TextBlock Text="Ajouter un « Si ... Alors ... »" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Astuce : active « Si » sur une règle pour décider quoi faire selon l'égalité, l'inégalité, l'inclusion ou l'exclusion (garder, exclure, transformer ou valeur de repli)."
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextFaintBrush}"
                           TextWrapping="Wrap" />
            </Grid>

            <!-- Mode Manuel -->
            <Grid Grid.Row="3"
                  IsVisible="{Binding IsManualMode}"
                  RowDefinitions="*,Auto,Auto"
                  RowSpacing="6">
                <TextBox Grid.Row="0"
                         Classes="mono"
                         Text="{Binding ManualText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontSize="{DynamicResource FontSizeMono}"
                         ScrollViewer.AllowAutoHide="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Édition manuelle des conditions" />

                <TextBlock Grid.Row="1"
                           IsVisible="{Binding HasManualError}"
                           Text="{Binding ManualError}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="2"
                           Text="Syntaxes : si &lt;test&gt; alors &lt;action&gt; sinon &lt;action&gt; | egal | != | dans_liste &quot;a,b&quot; | !dans_liste | !commence | !finit | est_vide | non_vide | nombre == != &gt; &gt;= &lt; &lt;= | longueur == &gt;= &lt;= | prefixer | suffixer | definir | garder | exclure | [icase] | [inactif]"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextFaintBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>

</UserControl>
