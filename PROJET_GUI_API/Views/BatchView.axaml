<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiTester.ViewModels"
             xmlns:models="using:ApiTester.Models"
             xmlns:views="using:ApiTester.Views"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="640"
             x:Class="ApiTester.Views.BatchView"
             x:DataType="vm:BatchViewModel">

    <UserControl.Styles>
        <Style Selector="Border.batchStatusPill">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Border.batchStatusPill TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Border.batchStatusPill Ellipse.batchDot">
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Border.batchStatusPill.success">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        </Style>
        <Style Selector="Border.batchStatusPill.success TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.batchStatusPill.success Ellipse.batchDot">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="Border.batchStatusPill.redirect">
            <Setter Property="Background" Value="{DynamicResource WarningBadgeSoftBrush}" />
        </Style>
        <Style Selector="Border.batchStatusPill.redirect TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.batchStatusPill.redirect Ellipse.batchDot">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="Border.batchStatusPill.error">
            <Setter Property="Background" Value="{DynamicResource DangerBadgeSoftBrush}" />
        </Style>
        <Style Selector="Border.batchStatusPill.error TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Border.batchStatusPill.error Ellipse.batchDot">
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
        </Style>

        <Style Selector="Border.batchStatusPill.ratelimit">
            <Setter Property="Background" Value="{DynamicResource WarningBadgeSoftBrush}" />
        </Style>
        <Style Selector="Border.batchStatusPill.ratelimit TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.batchStatusPill.ratelimit Ellipse.batchDot">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="TextBlock.rateLimitStat">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.rateLimitStat.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <!-- Haut : zone curl + barre d'outils sur une ligne + avertissements repliés -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBox Text="{Binding CurlText}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="96"
                     FontFamily="{DynamicResource MonoFontFamily}"
                     FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PlaceholderText="Colle ici ta commande curl"
                     AutomationProperties.Name="Commande curl" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary"
                        Content="Analyser"
                        Command="{Binding ParseCommand}"
                        AutomationProperties.Name="Analyser la commande curl" />
                <Button Classes="ghost"
                        Content="Effacer"
                        Command="{Binding ClearCommand}"
                        AutomationProperties.Name="Effacer la commande curl" />
                <Button Classes="secondary"
                        Content="Ouvrir dans l'onglet Requête"
                        Command="{Binding OpenInSingleRequestCommand}"
                        AutomationProperties.Name="Ouvrir dans l'onglet Requête" />
            </StackPanel>

            <!-- Notice discrète si la requête envoyée vers l'onglet Requête contient des variables -->
            <Border IsVisible="{Binding HasOpenInSingleRequestWarning}"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="8,5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="iconStroke"
                          Data="{StaticResource IconWarning}"
                          Stroke="{DynamicResource WarningBrush}"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OpenInSingleRequestWarning}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Bandeau d'avertissements fin, replié par défaut -->
            <Border IsVisible="{Binding HasWarnings}"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Expander Classes="warningExpander" IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="iconStroke"
                                  Width="13"
                                  Height="13"
                                  Data="{StaticResource IconWarning}"
                                  Stroke="{DynamicResource WarningBrush}" />
                            <TextBlock Text="{Binding WarningsSummaryText}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource WarningBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="240"
                                  AllowAutoHide="False"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="26,0,12,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               TextWrapping="Wrap"
                                               Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </Border>
        </StackPanel>

        <!-- Corps du lot après analyse -->
        <Grid Grid.Row="1"
              IsVisible="{Binding HasParsed}"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="190" />
            </Grid.RowDefinitions>

            <!-- Récapitulatif Méthode + URL éditable -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource BadgeCornerRadius}"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Method, Converter={x:Static conv:HttpMethodConverters.ToUpper}}"
                                   Classes="httpMethod"
                                   Classes.get="{Binding Method, Converter={x:Static conv:HttpMethodConverters.IsGet}}"
                                   Classes.post="{Binding Method, Converter={x:Static conv:HttpMethodConverters.IsPost}}"
                                   Classes.put="{Binding Method, Converter={x:Static conv:HttpMethodConverters.IsPutOrPatch}}"
                                   Classes.delete="{Binding Method, Converter={x:Static conv:HttpMethodConverters.IsDelete}}" />
                    </Border>
                    <TextBox Grid.Column="1"
                             Classes="mono"
                             Text="{Binding Url}"
                             PlaceholderText="URL de la requête (ex. https://api.exemple.com/users/{{id}})"
                             ToolTip.Tip="{Binding Url, Converter={x:Static conv:StringDisplayConverters.EmptyToNull}}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="URL de la requête du lot" />
                </Grid>
            </Border>

            <!-- Onglets de configuration du lot -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Padding="10,4,10,10">
                <TabControl Classes="sub">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Paramètres d'URL" VerticalAlignment="Center" />
                                <Border IsVisible="{Binding VaryingParams.Count, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="{DynamicResource BadgeCornerRadius}"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VaryingParams.Count}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <views:VaryingParamEditor Margin="0,8,0,0"
                                                  Items="{Binding VaryingParams}"
                                                  AddCommand="{Binding AddVaryingParamCommand}"
                                                  RemoveCommand="{Binding RemoveVaryingParamCommand}" />
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="En-têtes" VerticalAlignment="Center" />
                                <Border IsVisible="{Binding Headers.Count, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="{DynamicResource BadgeCornerRadius}"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Headers.Count}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <views:KeyValueEditor Margin="0,8,0,0"
                                              Items="{Binding Headers}"
                                              AddCommand="{Binding AddHeaderCommand}"
                                              RemoveCommand="{Binding RemoveHeaderCommand}"
                                              AddButtonText="Ajouter un en-tête"
                                              KeyPlaceholder="Nom de l'en-tête"
                                              ValuePlaceholder="Valeur" />
                    </TabItem>

                    <TabItem Header="Corps">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6" Margin="0,8,0,0">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Type de corps"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{x:Static vm:BatchViewModel.BodyTypes}"
                                          SelectedItem="{Binding BodyType}"
                                          MinWidth="160"
                                          AutomationProperties.Name="Type de corps du lot" />
                            </StackPanel>

                            <TextBox Grid.Row="1"
                                     IsVisible="{Binding !IsFormBody}"
                                     Classes="mono"
                                     Text="{Binding Body}"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     LineHeight="19"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="Aucun corps (ou saisissez le corps à envoyer)..."
                                     AutomationProperties.Name="Corps de la requête du lot" />

                            <views:KeyValueEditor Grid.Row="1"
                                                  IsVisible="{Binding IsFormBody}"
                                                  Items="{Binding FormFields}"
                                                  AddCommand="{Binding AddFormFieldCommand}"
                                                  RemoveCommand="{Binding RemoveFormFieldCommand}"
                                                  AddButtonText="Ajouter un champ"
                                                  KeyPlaceholder="Champ"
                                                  ValuePlaceholder="Valeur" />

                            <TextBlock Grid.Row="2"
                                       Text="Utilise {{nom}} pour insérer une variable. Variables prédéfinies : {{$index}}, {{$guid}}, {{$timestamp}}."
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Variables" VerticalAlignment="Center" />
                                <Border IsVisible="{Binding UsedVariablesCount, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="{DynamicResource BadgeCornerRadius}"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UsedVariablesCount}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <views:BatchVariableEditor Margin="0,8,0,0"
                                                   Items="{Binding Variables}" />
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Séparateur horizontal fin -->
            <GridSplitter Grid.Row="2"
                          Classes="horizontal"
                          ResizeDirection="Rows" />

            <!-- Ordre d'imbrication des boucles + barre d'exécution compacte + erreur variables + aperçu -->
            <StackPanel Grid.Row="3" Spacing="6">
                <views:BatchOrderPanel IsVisible="{Binding HasMultipleAxes}"
                                       MoveUpCommand="{Binding MoveAxisUpCommand}"
                                       MoveDownCommand="{Binding MoveAxisDownCommand}" />

                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="{DynamicResource PanelCornerRadius}"
                        Padding="10,8">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Mode"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{x:Static vm:BatchViewModel.BatchModes}"
                                              SelectedItem="{Binding SelectedMode}"
                                              MinWidth="136"
                                              AutomationProperties.Name="Mode de génération des paramètres">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:BatchMode">
                                                <TextBlock Text="{Binding Converter={x:Static conv:BatchModeConverters.ToLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Pause (ms)"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding DelayMs, Converter={x:Static conv:DelayMsToDecimalConverter.Instance}, Mode=TwoWay}"
                                                   Minimum="0"
                                                   Maximum="60000"
                                                   Increment="100"
                                                   FormatString="0"
                                                   MinWidth="148"
                                                   Width="148"
                                                   AutomationProperties.Name="Pause entre requêtes en millisecondes" />
                                </StackPanel>

                                <CheckBox IsChecked="{Binding StopOnFailure}"
                                          Content="Arrêter au premier échec"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Arrêter au premier échec" />

                                <CheckBox IsChecked="{Binding KeepBodies}"
                                          Content="Conserver les corps"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Conserver les corps de réponse" />

                                <CheckBox IsVisible="{Binding NeedsConfirmation}"
                                          IsChecked="{Binding IsConfirmed}"
                                          Content="Confirmer (> 500 requêtes)"
                                          FontWeight="Medium"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Confirmer l'envoi de plus de 500 requêtes" />
                            </WrapPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalRequestsText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />

                                <Button Classes="secondary"
                                        Content="Aperçu"
                                        Command="{Binding PreviewCommand}"
                                        AutomationProperties.Name="Aperçu des premières requêtes" />

                                <Panel VerticalAlignment="Center">
                                    <Button Classes="primary"
                                            Command="{Binding RunCommand}"
                                            IsVisible="{Binding !IsRunning}"
                                            MinWidth="96"
                                            AutomationProperties.Name="Lancer le lot">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="iconStroke" Data="{StaticResource IconSend}" />
                                            <TextBlock Text="Lancer" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary"
                                            Command="{Binding RunCancelCommand}"
                                            IsVisible="{Binding IsRunning}"
                                            MinWidth="96"
                                            AutomationProperties.Name="Annuler le lot">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="iconStroke" Data="{StaticResource IconStop}" />
                                            <TextBlock Text="Annuler" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Panel>
                            </StackPanel>
                        </Grid>

                        <!-- Seconde ligne : Enregistrement des réponses -->
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,8,0,0">
                            <StackPanel Spacing="6">
                                <StackPanel IsEnabled="{Binding !IsRunning}" Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Text="Enregistrement des réponses"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox ItemsSource="{x:Static vm:BatchViewModel.SaveModes}"
                                                      SelectedItem="{Binding SaveMode}"
                                                      MinWidth="190"
                                                      Margin="0,0,12,0"
                                                      AutomationProperties.Name="Mode d'enregistrement des réponses">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SaveMode">
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SaveModeConverters.ToLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <CheckBox IsVisible="{Binding CanChooseFolder}"
                                                      IsChecked="{Binding CreateTimestampSubfolder}"
                                                      Content="Créer un sous-dossier horodaté"
                                                      Margin="0,0,12,0"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Créer un sous-dossier horodaté" />

                                            <CheckBox IsVisible="{Binding ShowPerRequestOptions}"
                                                      IsChecked="{Binding IncludeSummaryCsv}"
                                                      Content="Inclure un fichier _resume.csv"
                                                      Margin="0,0,12,0"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Inclure un fichier _resume.csv" />

                                            <StackPanel IsVisible="{Binding ShowGroupedOptions}"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Format groupé"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <ComboBox ItemsSource="{x:Static vm:BatchViewModel.GroupedFormats}"
                                                          SelectedItem="{Binding GroupedFormat}"
                                                          MinWidth="220"
                                                          AutomationProperties.Name="Format du fichier groupé">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:GroupedFormat">
                                                            <TextBlock Text="{Binding Converter={x:Static conv:GroupedFormatConverters.ToLabel}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </WrapPanel>
                                    </Grid>

                                    <Grid IsVisible="{Binding CanChooseFolder}"
                                          ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   Text="Dossier"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Classes="mono"
                                                 Text="{Binding OutputFolder}"
                                                 PlaceholderText="Chemin du dossier de destination"
                                                 AutomationProperties.Name="Dossier d'enregistrement des réponses" />
                                        <Button Grid.Column="2"
                                                Classes="secondary"
                                                Command="{Binding BrowseFolderCommand}"
                                                MinWidth="96"
                                                AutomationProperties.Name="Choisir le dossier d'enregistrement">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="iconStroke" Data="{StaticResource IconFolder}" />
                                                <TextBlock Text="Choisir…" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <TextBlock IsVisible="{Binding CanChooseFolder}"
                                           Text="Les réponses sont enregistrées en clair sur ton disque. Elles peuvent contenir des données personnelles."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFaintBrush}"
                                           TextWrapping="Wrap" />

                                <TextBlock IsVisible="{Binding HasSaveError}"
                                           Text="{Binding SaveError}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           TextWrapping="Wrap" />

                                <TextBlock IsVisible="{Binding HasActiveOutputPath}"
                                           Text="{Binding ActiveOutputPathText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel IsVisible="{Binding HasSaveSummary}"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SaveSummaryText}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                    <Button Classes="secondary"
                                            Command="{Binding OpenOutputFolderCommand}"
                                            AutomationProperties.Name="Ouvrir le dossier d'enregistrement">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="iconStroke" Data="{StaticResource IconFolder}" />
                                            <TextBlock Text="Ouvrir le dossier" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bandeau d'avertissement si pause globale < 100 ms -->
                        <Border IsVisible="{Binding ShowLowPauseWarning}"
                                Background="{DynamicResource WarningSoftBrush}"
                                BorderBrush="{DynamicResource WarningBorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="8,6">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="iconStroke"
                                          Data="{StaticResource IconWarning}"
                                          Stroke="{DynamicResource WarningBrush}"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Pause inférieure à 100 ms : risque élevé de déclencher un rate limit sur l'API."
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsLowPauseConfirmed}"
                                          Content="Je confirme vouloir continuer avec une pause aussi courte"
                                          FontWeight="Medium"
                                          AutomationProperties.Name="Je confirme vouloir continuer avec une pause aussi courte" />
                            </StackPanel>
                        </Border>

                        <!-- Troisième ligne : Gestion du rate limit (repliée par défaut) -->
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,4,0,0">
                            <Expander Classes="sectionExpander"
                                      IsExpanded="False"
                                      AutomationProperties.Name="Gestion du rate limit">
                                <Expander.Header>
                                    <TextBlock Text="Gestion du rate limit"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Expander.Header>

                                <StackPanel IsEnabled="{Binding !IsRunning}"
                                            Spacing="8"
                                            Margin="0,6,0,2">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding RateLimitPolicy.IsEnabled}"
                                                  Content="Activer la gestion du rate limit"
                                                  Margin="0,0,14,4"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Activer la gestion du rate limit" />

                                        <CheckBox IsChecked="{Binding RateLimitPolicy.RespectRetryAfter}"
                                                  Content="Respecter Retry-After"
                                                  Margin="0,0,14,4"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Respecter Retry-After" />

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="0,0,14,4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Plafond Retry-After (s)"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitMaxRetryAfterSecondsText}"
                                                     Width="68"
                                                     AutomationProperties.Name="Plafond Retry-After en secondes" />
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding !RateLimitPolicy.EnableBackoff}"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="0,0,0,4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Tentatives max par requête"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitMaxRetriesText}"
                                                     Width="56"
                                                     AutomationProperties.Name="Tentatives max par requête" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <CheckBox IsChecked="{Binding RateLimitPolicy.EnableBackoff}"
                                              Content="Ralentissement progressif (backoff) en l'absence de Retry-After"
                                              AutomationProperties.Name="Ralentissement progressif en l'absence de Retry-After" />

                                    <WrapPanel IsVisible="{Binding RateLimitPolicy.EnableBackoff}"
                                               Orientation="Horizontal">
                                        <StackPanel Spacing="3" Margin="0,0,12,4">
                                            <TextBlock Text="Délai initial (ms)"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitBackoffInitialMsText}"
                                                     Width="96"
                                                     AutomationProperties.Name="Délai initial de backoff en millisecondes" />
                                        </StackPanel>

                                        <StackPanel Spacing="3" Margin="0,0,12,4">
                                            <TextBlock Text="Multiplicateur"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitBackoffMultiplierText}"
                                                     Width="84"
                                                     AutomationProperties.Name="Multiplicateur de backoff" />
                                        </StackPanel>

                                        <StackPanel Spacing="3" Margin="0,0,12,4">
                                            <TextBlock Text="Délai maximal (ms)"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitBackoffMaxMsText}"
                                                     Width="104"
                                                     AutomationProperties.Name="Délai maximal de backoff en millisecondes" />
                                        </StackPanel>

                                        <StackPanel Spacing="3" Margin="0,0,0,4">
                                            <TextBlock Text="Tentatives max par requête"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitMaxRetriesText}"
                                                     Width="84"
                                                     AutomationProperties.Name="Tentatives max par requête" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <WrapPanel Orientation="Horizontal">
                                        <StackPanel Spacing="3" Margin="0,0,12,4">
                                            <TextBlock Text="Codes HTTP supplémentaires traités comme rate limit"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitExtraStatusCodesText}"
                                                     MinWidth="200"
                                                     PlaceholderText="ex. 503"
                                                     AutomationProperties.Name="Codes HTTP supplémentaires traités comme rate limit" />
                                        </StackPanel>

                                        <StackPanel Spacing="3" Margin="0,0,12,4">
                                            <TextBlock Text="En-tête de quota restant"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitPolicy.QuotaRemainingHeader}"
                                                     MinWidth="190"
                                                     PlaceholderText="ex. X-RateLimit-Remaining"
                                                     AutomationProperties.Name="En-tête de quota restant" />
                                        </StackPanel>

                                        <StackPanel Spacing="3" Margin="0,0,12,4">
                                            <TextBlock Text="En-tête de réinitialisation du quota"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitPolicy.QuotaResetHeader}"
                                                     MinWidth="190"
                                                     PlaceholderText="ex. X-RateLimit-Reset"
                                                     AutomationProperties.Name="En-tête de réinitialisation du quota" />
                                        </StackPanel>

                                        <StackPanel Spacing="3" Margin="0,0,0,4">
                                            <TextBlock Text="Seuil de ralentissement préventif"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBox Classes="mono"
                                                     Text="{Binding RateLimitQuotaThresholdText}"
                                                     Width="96"
                                                     AutomationProperties.Name="Seuil de ralentissement préventif" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <TextBlock Text="Laisse vide si l'API n'en fournit pas."
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextFaintBrush}"
                                               TextWrapping="Wrap" />

                                    <TextBlock IsVisible="{Binding HasRateLimitError}"
                                               Text="{Binding RateLimitValidationError}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource DangerBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <TextBlock IsVisible="{Binding HasPlanError}"
                                   Text="{Binding PlanError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Bandeau fin d'erreur / avertissement sur les variables -->
                <Border IsVisible="{Binding HasVariablesError}"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="iconStroke"
                              Data="{StaticResource IconWarning}"
                              Stroke="{DynamicResource WarningBrush}"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VariablesError}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Panneau repliable d'aperçu des premières requêtes -->
                <views:BatchPreviewPanel IsVisible="{Binding HasPreviewItems}"
                                         Items="{Binding PreviewItems}"
                                         IsExpanded="{Binding IsPreviewOpen, Mode=TwoWay}" />
            </StackPanel>

            <!-- Bas : résultats + détail de la réponse sélectionnée -->
            <Grid Grid.Row="4" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Tableau compact des résultats -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="{DynamicResource PanelCornerRadius}"
                        Padding="10">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                        <!-- Barre de progression fine (pendant exécution) + synthèse rate limit (pendant et après) -->
                        <StackPanel Grid.Row="0"
                                    IsVisible="{Binding HasBatchStats}"
                                    Spacing="4">
                            <Grid IsVisible="{Binding IsRunning}"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <ProgressBar Grid.Column="0"
                                             Minimum="0"
                                             Maximum="{Binding ProgressTotal}"
                                             Value="{Binding ProgressCurrent}"
                                             Height="2"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Progression du lot" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressText}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <WrapPanel Orientation="Horizontal"
                                       ToolTip.Tip="{Binding RateLimitSummaryText}"
                                       AutomationProperties.Name="{Binding RateLimitSummaryText}">
                                <TextBlock Text="{Binding SuccessSummaryPart}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding RateLimitSummaryPart}"
                                           Classes="rateLimitStat"
                                           Classes.warning="{Binding HasRateLimitOccurrences}"
                                           FontSize="{DynamicResource FontSizeSmall}" />
                                <TextBlock Text="{Binding OtherErrorSummaryPart}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- En-tête fixe -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding HasResults}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,0,20,4">
                            <Grid ColumnDefinitions="40,*,160,68,68" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="#"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="1"
                                           Text="Paramètres"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="Statut"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="3"
                                           Text="Durée"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4"
                                           Text="Taille"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- État vide -->
                        <TextBlock Grid.Row="2"
                                   IsVisible="{Binding !HasResults}"
                                   Text="Aucun résultat. Analyse une commande curl puis lance le lot."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />

                        <!-- Liste des résultats -->
                        <ListBox Grid.Row="2"
                                 IsVisible="{Binding HasResults}"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult}"
                                 ScrollViewer.AllowAutoHide="False"
                                 AutomationProperties.Name="Résultats du lot">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:BatchResultItem">
                                    <StackPanel Spacing="2" Margin="0,0,8,0">
                                        <Grid ColumnDefinitions="40,*,160,68,68"
                                              ColumnSpacing="8"
                                              MinHeight="28">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Index}"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ParamsText}"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ParamsText, Converter={x:Static conv:StringDisplayConverters.EmptyToNull}}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="2"
                                                    Classes="batchStatusPill"
                                                    Classes.success="{Binding StatusCategory, Converter={x:Static conv:StatusCategoryConverters.IsSuccess}}"
                                                    Classes.redirect="{Binding StatusCategory, Converter={x:Static conv:StatusCategoryConverters.IsRedirect}}"
                                                    Classes.error="{Binding StatusCategory, Converter={x:Static conv:StatusCategoryConverters.IsError}}"
                                                    Classes.ratelimit="{Binding WasRateLimited}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse Classes="batchDot"
                                                             Width="6"
                                                             Height="6"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StatusCode}"
                                                               IsVisible="{Binding StatusCode, Converter={x:Static conv:StatusCategoryConverters.IsPositiveInt}}"
                                                               FontFamily="{DynamicResource MonoFontFamily}"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Erreur"
                                                               IsVisible="{Binding StatusCode, Converter={x:Static conv:StatusCategoryConverters.IsZeroInt}}"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding RateLimitSuffixText}"
                                                               IsVisible="{Binding WasRateLimited}"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               FontWeight="Medium"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding DurationMs, StringFormat='{}{0} ms'}"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding SizeText}"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   IsVisible="{Binding HasStandardErrorMessage}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,4" />

                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   IsVisible="{Binding HasRateLimitErrorMessage}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,4" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Séparateur vertical fin -->
                <GridSplitter Grid.Column="1"
                              Classes="vertical"
                              ResizeDirection="Columns" />

                <!-- Détail de la réponse sélectionnée -->
                <views:ResponseView Grid.Column="2"
                                    DataContext="{Binding SelectedResponse}" />
            </Grid>
        </Grid>
    </Grid>

</UserControl>
