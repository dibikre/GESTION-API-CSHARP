<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiTester.ViewModels"
             xmlns:models="using:ApiTester.Models"
             xmlns:views="using:ApiTester.Views"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="640"
             x:Class="ApiTester.Views.SingleRequestView"
             x:DataType="vm:SingleRequestViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
    </UserControl.KeyBindings>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>

        <!-- Barre d'envoi unifiée + progression fine -->
        <StackPanel Grid.Row="0" Spacing="4">
            <Border Classes="sendBar" Padding="2">
                <Grid ColumnDefinitions="Auto,1,2*,1,Auto,*,Auto,Auto">
                    <ComboBox Grid.Column="0"
                              Classes="borderless"
                              ItemsSource="{x:Static vm:RequestViewModel.Methods}"
                              SelectedItem="{Binding Request.Method}"
                              MinWidth="92"
                              AutomationProperties.Name="Méthode HTTP">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:HttpMethodType">
                                <TextBlock Text="{Binding Converter={x:Static conv:HttpMethodConverters.ToUpper}}"
                                           Classes="httpMethod"
                                           Classes.get="{Binding Converter={x:Static conv:HttpMethodConverters.IsGet}}"
                                           Classes.post="{Binding Converter={x:Static conv:HttpMethodConverters.IsPost}}"
                                           Classes.put="{Binding Converter={x:Static conv:HttpMethodConverters.IsPutOrPatch}}"
                                           Classes.delete="{Binding Converter={x:Static conv:HttpMethodConverters.IsDelete}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Grid.Column="1"
                            Width="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,5" />

                    <TextBox Grid.Column="2"
                             Classes="borderless mono"
                             Text="{Binding Request.Url}"
                             MinWidth="180"
                             PlaceholderText="https://api.exemple.com/ressource"
                             AutomationProperties.Name="URL de la requête">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Border Grid.Column="3"
                            Width="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,5" />

                    <ComboBox Grid.Column="4"
                              Classes="borderless"
                              ItemsSource="{x:Static vm:ResponseViewModel.FilterModes}"
                              SelectedItem="{Binding Response.FilterMode}"
                              MinWidth="86"
                              ToolTip.Tip="Mode d'affinage de la réponse (Auto, JSONPath, Regex, XPath)"
                              AutomationProperties.Name="Mode d'affinage de la réponse">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ResponseFilterMode">
                                <TextBlock Text="{Binding Converter={x:Static conv:ResponseFilterModeConverters.ToLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Grid.Column="5"
                             Classes="borderless mono"
                             Text="{Binding Response.FilterExpression}"
                             MinWidth="140"
                             PlaceholderText="Regex ou parse (ex. data.items[*].id)"
                             ToolTip.Tip="Expression Regex, JSONPath ou XPath pour affiner la réponse affichée (optionnel)"
                             AutomationProperties.Name="Regex ou expression de parse pour affiner la réponse">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding Response.ApplyFilterCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Button Grid.Column="6"
                            Classes="icon"
                            IsVisible="{Binding Response.IsFilterActive}"
                            Command="{Binding Response.ClearFilterCommand}"
                            VerticalAlignment="Center"
                            Margin="0,0,2,0"
                            ToolTip.Tip="Effacer le filtre de réponse"
                            AutomationProperties.Name="Effacer le filtre de réponse">
                        <Path Classes="iconStroke" Data="{StaticResource IconClose}" />
                    </Button>

                    <Panel Grid.Column="7" Margin="4,0,0,0">
                        <Button Classes="primary"
                                Command="{Binding SendCommand}"
                                IsVisible="{Binding !Response.IsBusy}"
                                MinWidth="96"
                                AutomationProperties.Name="Envoyer la requête">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="iconStroke" Data="{StaticResource IconSend}" />
                                <TextBlock Text="Envoyer" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Classes="secondary"
                                Command="{Binding SendCancelCommand}"
                                IsVisible="{Binding Response.IsBusy}"
                                MinWidth="96"
                                AutomationProperties.Name="Annuler la requête">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="iconStroke" Data="{StaticResource IconStop}" />
                                <TextBlock Text="Annuler" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Panel>
                </Grid>
            </Border>

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding Response.IsBusy}"
                         Height="2"
                         AutomationProperties.Name="Envoi de la requête en cours" />
        </StackPanel>

        <!-- Panneau Requête -->
        <views:RequestView Grid.Row="1"
                           DataContext="{Binding Request}" />

        <!-- Séparateur fin -->
        <GridSplitter Grid.Row="2"
                      Classes="horizontal"
                      ResizeDirection="Rows" />

        <!-- Panneau Réponse -->
        <views:ResponseView Grid.Row="3"
                            DataContext="{Binding Response}" />
    </Grid>

</UserControl>
