<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:ApiTester.Models"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="220"
             x:Class="ApiTester.Views.KeyValueEditor"
             x:Name="Root"
             x:DataType="x:Object">

    <Grid RowDefinitions="Auto,*">
        <!-- En-têtes de colonnes -->
        <Border Grid.Row="0"
                IsVisible="{Binding #ItemsList.ItemCount, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,0,12,4">
            <Grid ColumnDefinitions="32,*,2*,28" ColumnSpacing="6">
                <TextBlock Grid.Column="0"
                           Text="Actif"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Nom"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="6,0,0,0" />
                <TextBlock Grid.Column="2"
                           Text="Valeur"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="6,0,0,0" />
            </Grid>
        </Border>

        <!-- État vide -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding #ItemsList.ItemCount, Converter={x:Static conv:CollectionCountConverters.IsZero}}"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Aucun élément. Clique sur « + Ajouter »."
                       FontSize="13"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" />
            <Button Classes="ghost"
                    HorizontalAlignment="Center"
                    Command="{Binding #Root.AddCommand}"
                    AutomationProperties.Name="Ajouter une ligne">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="iconStroke" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="{Binding #Root.AddButtonText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Liste compacte avec gouttière droite pour éviter tout chevauchement avec la barre de défilement -->
        <ScrollViewer Grid.Row="1"
                      IsVisible="{Binding #ItemsList.ItemCount, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                      AllowAutoHide="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,4" Spacing="0">
                <ItemsControl x:Name="ItemsList" ItemsSource="{Binding #Root.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:KeyValueItem">
                            <Border Classes="kvRow"
                                    Height="28"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="32,*,2*,28" ColumnSpacing="6">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsEnabled}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Activer l'élément" />

                                    <TextBox Grid.Column="1"
                                             Classes="kvCell"
                                             Text="{Binding Key}"
                                             PlaceholderText="{Binding #Root.KeyPlaceholder}"
                                             ToolTip.Tip="{Binding Key, Converter={x:Static conv:StringDisplayConverters.EmptyToNull}}"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Clé" />

                                    <Grid Grid.Column="2"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="4"
                                          VerticalAlignment="Center">
                                        <Panel Grid.Column="0"
                                               Classes="kvValueCell"
                                               Classes.hasValue="{Binding Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               ToolTip.Tip="{Binding Value, Converter={x:Static conv:StringDisplayConverters.EmptyToNull}}"
                                               VerticalAlignment="Center">
                                            <TextBox Classes="kvCell"
                                                     Text="{Binding Value}"
                                                     PlaceholderText="{Binding #Root.ValuePlaceholder}"
                                                     AutomationProperties.Name="Valeur" />
                                            <TextBlock Classes="kvTruncatedOverlay"
                                                       Text="{Binding Value}"
                                                       FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0" />
                                        </Panel>

                                        <Button Grid.Column="1"
                                                Classes="secondary"
                                                Height="22"
                                                MinHeight="22"
                                                Padding="8,0"
                                                FontSize="11.5"
                                                Content="Éditer"
                                                Command="{Binding #Root.EditCookieCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Éditer les cookies dans un tableau"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Éditer les cookies">
                                            <Button.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding ElementName="Root" Path="EnableCookieEditor" />
                                                    <Binding Path="Key" Converter="{x:Static conv:HeaderKeyConverters.IsCookie}" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                        </Button>
                                    </Grid>

                                    <Button Grid.Column="3"
                                            Classes="icon danger kvDelete"
                                            Command="{Binding #Root.RemoveCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Supprimer"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Supprimer la ligne">
                                        <Path Classes="iconStroke" Data="{StaticResource IconTrash}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Classes="ghost"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,2"
                        Command="{Binding #Root.AddCommand}"
                        AutomationProperties.Name="Ajouter une ligne">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="iconStroke" Data="{StaticResource IconPlus}" />
                        <TextBlock Text="{Binding #Root.AddButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
