<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiTester.ViewModels"
             xmlns:views="using:ApiTester.Views"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="300"
             x:Class="ApiTester.Views.RequestView"
             x:DataType="vm:RequestViewModel">

    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="{DynamicResource PanelCornerRadius}"
            Padding="10,4,10,10">
        <TabControl Classes="sub">
            <!-- Onglet Paramètres -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Paramètres" VerticalAlignment="Center" />
                        <Border IsVisible="{Binding QueryParams.Count, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                Padding="5,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding QueryParams.Count}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:KeyValueEditor Margin="0,8,0,0"
                                      Items="{Binding QueryParams}"
                                      AddCommand="{Binding AddQueryParamCommand}"
                                      RemoveCommand="{Binding RemoveQueryParamCommand}"
                                      AddButtonText="Ajouter un paramètre"
                                      KeyPlaceholder="Nom du paramètre"
                                      ValuePlaceholder="Valeur" />
            </TabItem>

            <!-- Onglet En-têtes -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="En-têtes" VerticalAlignment="Center" />
                        <Border IsVisible="{Binding Headers.Count, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                Padding="5,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headers.Count}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <views:KeyValueEditor Margin="0,8,0,0"
                                      Items="{Binding Headers}"
                                      AddCommand="{Binding AddHeaderCommand}"
                                      RemoveCommand="{Binding RemoveHeaderCommand}"
                                      AddButtonText="Ajouter un en-tête"
                                      KeyPlaceholder="Nom de l'en-tête"
                                      ValuePlaceholder="Valeur" />
            </TabItem>

            <!-- Onglet Authentification -->
            <TabItem Header="Authentification">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              AllowAutoHide="False">
                    <StackPanel Margin="0,10,12,0" Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
                            <TextBlock Grid.Column="0"
                                       Text="Type"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Static vm:RequestViewModel.AuthTypes}"
                                      SelectedItem="{Binding AuthType}"
                                      MinWidth="200"
                                      AutomationProperties.Name="Type d'authentification" />
                        </Grid>

                        <!-- Bearer -->
                        <Grid IsVisible="{Binding IsBearerAuth}"
                              ColumnDefinitions="150,*"
                              ColumnSpacing="10">
                            <TextBlock Grid.Column="0"
                                       Text="Jeton Bearer"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Classes="mono"
                                     Text="{Binding Token}"
                                     PlaceholderText="Collez votre jeton Bearer..."
                                     AutomationProperties.Name="Jeton Bearer" />
                        </Grid>

                        <!-- Basic -->
                        <StackPanel IsVisible="{Binding IsBasicAuth}" Spacing="8">
                            <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="Nom d'utilisateur"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Username}"
                                         PlaceholderText="Utilisateur"
                                         AutomationProperties.Name="Nom d'utilisateur Basic" />
                            </Grid>
                            <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="Mot de passe"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Password}"
                                         PasswordChar="•"
                                         PlaceholderText="Mot de passe"
                                         AutomationProperties.Name="Mot de passe Basic" />
                            </Grid>
                        </StackPanel>

                        <!-- API Key -->
                        <StackPanel IsVisible="{Binding IsApiKeyAuth}" Spacing="8">
                            <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="Nom de la clé"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding ApiKeyName}"
                                         PlaceholderText="ex. X-API-Key ou api_key"
                                         AutomationProperties.Name="Nom de la clé API" />
                            </Grid>
                            <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="Valeur de la clé"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Classes="mono"
                                         Text="{Binding ApiKeyValue}"
                                         PlaceholderText="Valeur de la clé API"
                                         AutomationProperties.Name="Valeur de la clé API" />
                            </Grid>
                            <CheckBox Margin="160,0,0,0"
                                      IsChecked="{Binding ApiKeyInHeader}"
                                      Content="Envoyer dans l'en-tête HTTP (sinon en paramètre)"
                                      AutomationProperties.Name="Envoyer la clé API dans l'en-tête" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet Corps -->
            <TabItem Header="Corps">
                <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="0,8,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0"
                                   Text="Type de corps"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Static vm:RequestViewModel.BodyTypes}"
                                  SelectedItem="{Binding BodyType}"
                                  MinWidth="160"
                                  AutomationProperties.Name="Type de corps" />

                        <TextBlock Grid.Column="3"
                                   Text="Délai max (s)"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="4"
                                       Value="{Binding TimeoutSeconds, Converter={x:Static conv:IntToDecimalConverter.Instance}, Mode=TwoWay}"
                                       Minimum="1"
                                       Maximum="3600"
                                       Increment="5"
                                       FormatString="0"
                                       Width="104"
                                       AutomationProperties.Name="Délai d'expiration en secondes" />
                    </Grid>

                    <!-- Message si None -->
                    <TextBlock Grid.Row="1"
                               IsVisible="{Binding BodyType, Converter={x:Static conv:BodyTypeConverters.IsNone}}"
                               Text="Aucun corps ne sera envoyé avec cette requête."
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <!-- Éditeur JSON ou Texte -->
                    <TextBox Grid.Row="1"
                             Classes="mono"
                             Text="{Binding Body}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             LineHeight="19"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="Saisissez le contenu du corps de la requête..."
                             AutomationProperties.Name="Corps de la requête">
                        <TextBox.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="IsJsonBody" />
                                <Binding Path="IsTextBody" />
                            </MultiBinding>
                        </TextBox.IsVisible>
                    </TextBox>

                    <!-- Éditeur FormUrlEncoded -->
                    <views:KeyValueEditor Grid.Row="1"
                                          IsVisible="{Binding IsFormBody}"
                                          Items="{Binding FormFields}"
                                          AddCommand="{Binding AddFormFieldCommand}"
                                          RemoveCommand="{Binding RemoveFormFieldCommand}"
                                          AddButtonText="Ajouter un champ"
                                          KeyPlaceholder="Champ"
                                          ValuePlaceholder="Valeur" />
                </Grid>
            </TabItem>
        </TabControl>
    </Border>

</UserControl>
