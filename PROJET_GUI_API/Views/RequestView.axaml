<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiTester.ViewModels"
             xmlns:views="using:ApiTester.Views"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="300"
             x:Class="ApiTester.Views.RequestView"
             x:DataType="vm:RequestViewModel">

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <TabControl>
            <!-- Onglet Paramètres -->
            <TabItem Header="Paramètres">
                <views:KeyValueEditor Margin="0,8,0,0"
                                      Items="{Binding QueryParams}"
                                      AddCommand="{Binding AddQueryParamCommand}"
                                      RemoveCommand="{Binding RemoveQueryParamCommand}"
                                      AddButtonText="Ajouter un paramètre"
                                      KeyPlaceholder="Nom du paramètre"
                                      ValuePlaceholder="Valeur" />
            </TabItem>

            <!-- Onglet En-têtes -->
            <TabItem Header="En-têtes">
                <views:KeyValueEditor Margin="0,8,0,0"
                                      Items="{Binding Headers}"
                                      AddCommand="{Binding AddHeaderCommand}"
                                      RemoveCommand="{Binding RemoveHeaderCommand}"
                                      AddButtonText="Ajouter un en-tête"
                                      KeyPlaceholder="Nom de l'en-tête"
                                      ValuePlaceholder="Valeur" />
            </TabItem>

            <!-- Onglet Authentification -->
            <TabItem Header="Authentification">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0" Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Type d'authentification :"
                                       VerticalAlignment="Center"
                                       MinWidth="170" />
                            <ComboBox ItemsSource="{x:Static vm:RequestViewModel.AuthTypes}"
                                      SelectedItem="{Binding AuthType}"
                                      MinWidth="200"
                                      AutomationProperties.Name="Type d'authentification" />
                        </StackPanel>

                        <!-- Bearer -->
                        <StackPanel IsVisible="{Binding IsBearerAuth}" Spacing="6">
                            <TextBlock Text="Jeton Bearer (Token)" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Token}"
                                     PlaceholderText="Collez votre jeton Bearer..."
                                     AutomationProperties.Name="Jeton Bearer" />
                        </StackPanel>

                        <!-- Basic -->
                        <StackPanel IsVisible="{Binding IsBasicAuth}" Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Nom d'utilisateur" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Username}"
                                         PlaceholderText="Utilisateur"
                                         AutomationProperties.Name="Nom d'utilisateur Basic" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Mot de passe" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Password}"
                                         PasswordChar="•"
                                         PlaceholderText="Mot de passe"
                                         AutomationProperties.Name="Mot de passe Basic" />
                            </StackPanel>
                        </StackPanel>

                        <!-- API Key -->
                        <StackPanel IsVisible="{Binding IsApiKeyAuth}" Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Nom de la clé" FontWeight="SemiBold" />
                                <TextBox Text="{Binding ApiKeyName}"
                                         PlaceholderText="ex. X-API-Key ou api_key"
                                         AutomationProperties.Name="Nom de la clé API" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Valeur de la clé" FontWeight="SemiBold" />
                                <TextBox Text="{Binding ApiKeyValue}"
                                         PlaceholderText="Valeur de la clé API"
                                         AutomationProperties.Name="Valeur de la clé API" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ApiKeyInHeader}"
                                      Content="Envoyer dans l'en-tête HTTP (sinon en paramètre de requête)"
                                      AutomationProperties.Name="Envoyer la clé API dans l'en-tête" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Onglet Corps -->
            <TabItem Header="Corps">
                <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="0,8,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0"
                                   Text="Type de corps :"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Static vm:RequestViewModel.BodyTypes}"
                                  SelectedItem="{Binding BodyType}"
                                  MinWidth="170"
                                  AutomationProperties.Name="Type de corps" />

                        <TextBlock Grid.Column="3"
                                   Text="Délai max (s) :"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="4"
                                       Value="{Binding TimeoutSeconds, Converter={x:Static conv:IntToDecimalConverter.Instance}, Mode=TwoWay}"
                                       Minimum="1"
                                       Maximum="3600"
                                       Increment="5"
                                       FormatString="0"
                                       Width="120"
                                       AutomationProperties.Name="Délai d'expiration en secondes" />
                    </Grid>

                    <!-- Message si None -->
                    <TextBlock Grid.Row="1"
                               IsVisible="{Binding BodyType, Converter={x:Static conv:BodyTypeConverters.IsNone}}"
                               Text="Aucun corps ne sera envoyé avec cette requête."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <!-- Éditeur JSON ou Texte -->
                    <TextBox Grid.Row="1"
                             Text="{Binding Body}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas, Liberation Mono, Menlo, monospace"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="Saisissez le contenu du corps de la requête..."
                             AutomationProperties.Name="Corps de la requête">
                        <TextBox.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="IsJsonBody" />
                                <Binding Path="IsTextBody" />
                            </MultiBinding>
                        </TextBox.IsVisible>
                    </TextBox>

                    <!-- Éditeur FormUrlEncoded -->
                    <views:KeyValueEditor Grid.Row="1"
                                          IsVisible="{Binding IsFormBody}"
                                          Items="{Binding FormFields}"
                                          AddCommand="{Binding AddFormFieldCommand}"
                                          RemoveCommand="{Binding RemoveFormFieldCommand}"
                                          AddButtonText="Ajouter un champ"
                                          KeyPlaceholder="Champ"
                                          ValuePlaceholder="Valeur" />
                </Grid>
            </TabItem>
        </TabControl>
    </Border>

</UserControl>
