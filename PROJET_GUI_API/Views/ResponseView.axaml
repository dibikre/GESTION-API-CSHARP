<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiTester.ViewModels"
             xmlns:models="using:ApiTester.Models"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="300"
             x:Class="ApiTester.Views.ResponseView"
             x:DataType="vm:ResponseViewModel">

    <UserControl.Styles>
        <Style Selector="Border.statusPill">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Border.statusPill TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Border.statusPill Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Border.statusPill.success">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.statusPill.success TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.statusPill.success Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="Border.statusPill.redirect">
            <Setter Property="Background" Value="{DynamicResource WarningBadgeSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.statusPill.redirect TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.statusPill.redirect Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="Border.statusPill.error">
            <Setter Property="Background" Value="{DynamicResource DangerBadgeSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.statusPill.error TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Border.statusPill.error Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="{DynamicResource PanelCornerRadius}"
            Padding="10">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <!-- État vide -->
            <StackPanel Grid.Row="0"
                        Grid.RowSpan="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!HasResponse" />
                        <Binding Path="!HasError" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <Path Classes="iconStroke"
                      Width="15"
                      Height="15"
                      Data="{StaticResource IconInfo}"
                      Stroke="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="Envoie une requête pour voir la réponse"
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Ligne de statut en pastilles -->
            <WrapPanel Grid.Row="0"
                       IsVisible="{Binding HasResponse}"
                       Orientation="Horizontal">
                <Border Classes="statusPill"
                        Classes.success="{Binding StatusCategory, Converter={x:Static conv:StatusCategoryConverters.IsSuccess}}"
                        Classes.redirect="{Binding StatusCategory, Converter={x:Static conv:StatusCategoryConverters.IsRedirect}}"
                        Classes.error="{Binding StatusCategory, Converter={x:Static conv:StatusCategoryConverters.IsError}}"
                        Margin="0,0,8,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="statusDot"
                                 Width="6"
                                 Height="6"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusCode}"
                                   IsVisible="{Binding StatusCode, Converter={x:Static conv:StatusCategoryConverters.IsPositiveInt}}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Erreur"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasError" />
                                    <Binding Path="StatusCode" Converter="{x:Static conv:StatusCategoryConverters.IsZeroInt}" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource BadgeCornerRadius}"
                        Padding="8,3"
                        Margin="0,0,8,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Durée"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DurationMs, StringFormat='{}{0} ms'}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource BadgeCornerRadius}"
                        Padding="8,3"
                        Margin="0,0,8,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Taille"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SizeText}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource BadgeCornerRadius}"
                        Padding="8,3"
                        Margin="0,0,0,4"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ContentType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ContentType}"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </WrapPanel>

            <!-- Bandeau d'erreur fin -->
            <Border Grid.Row="1"
                    IsVisible="{Binding HasError}"
                    Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="iconStroke"
                          Width="14"
                          Height="14"
                          Data="{StaticResource IconWarning}"
                          Stroke="{DynamicResource DangerBrush}"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Message d'erreur" />
                </StackPanel>
            </Border>

            <!-- Onglets Corps et En-têtes -->
            <TabControl Grid.Row="2"
                        Classes="sub"
                        IsVisible="{Binding StatusCode, Converter={x:Static conv:StatusCategoryConverters.IsPositiveInt}}">
                <TabItem Header="Corps">
                    <TextBox Margin="0,8,0,0"
                             Classes="mono"
                             Text="{Binding Body, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             LineHeight="19"
                             ScrollViewer.AllowAutoHide="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Corps de la réponse" />
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="En-têtes" VerticalAlignment="Center" />
                            <Border IsVisible="{Binding Headers.Count, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="{DynamicResource BadgeCornerRadius}"
                                    Padding="5,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Headers.Count}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Margin="0,8,0,0"
                                  AllowAutoHide="False"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Headers}" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:KeyValueItem">
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            MinHeight="28"
                                            Padding="4,4">
                                        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
                                            <SelectableTextBlock Grid.Column="0"
                                                                 Text="{Binding Key}"
                                                                 FontSize="12"
                                                                 FontWeight="Medium"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 TextTrimming="CharacterEllipsis"
                                                                 VerticalAlignment="Center" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding Value}"
                                                                 FontFamily="{DynamicResource MonoFontFamily}"
                                                                 FontSize="12"
                                                                 TextWrapping="Wrap"
                                                                 VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>

</UserControl>
