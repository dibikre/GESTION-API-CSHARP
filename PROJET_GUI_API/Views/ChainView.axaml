<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiTester.ViewModels"
             xmlns:models="using:ApiTester.Models"
             xmlns:views="using:ApiTester.Views"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="660"
             x:Class="ApiTester.Views.ChainView"
             x:Name="ChainRoot"
             x:DataType="vm:ChainViewModel">

    <UserControl.Styles>
        <Style Selector="Border.chainStatusPill">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource BadgeCornerRadius}" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Border.chainStatusPill TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Border.chainStatusPill Ellipse.chainDot">
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Border.chainStatusPill.success">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        </Style>
        <Style Selector="Border.chainStatusPill.success TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.chainStatusPill.success Ellipse.chainDot">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="Border.chainStatusPill.failed">
            <Setter Property="Background" Value="{DynamicResource DangerBadgeSoftBrush}" />
        </Style>
        <Style Selector="Border.chainStatusPill.failed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Border.chainStatusPill.failed Ellipse.chainDot">
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
        </Style>

        <Style Selector="Border.chainStatusPill.skipped">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>
        <Style Selector="Border.chainStatusPill.skipped TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        </Style>

        <Style Selector="SelectableTextBlock.varPending">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.15*" MinHeight="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
        </Grid.RowDefinitions>

        <!-- HAUT : Liste des étapes à gauche + Éditeur de l'étape sélectionnée à droite -->
        <Grid Grid.Row="0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" MinWidth="210" MaxWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Colonne gauche : Étapes -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Padding="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="Étapes"
                                   FontSize="{DynamicResource FontSizeBase}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="secondary"
                                Command="{Binding AddStepCommand}"
                                AutomationProperties.Name="Ajouter une étape à la chaîne">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Path Classes="iconStroke" Data="{StaticResource IconPlus}" />
                                <TextBlock Text="Ajouter" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               IsVisible="{Binding !HasSteps}"
                               Text="Aucune étape. Clique sur « + Ajouter »."
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

                    <ListBox Grid.Row="1"
                             IsVisible="{Binding HasSteps}"
                             ItemsSource="{Binding Steps}"
                             SelectedItem="{Binding SelectedStep}"
                             ScrollViewer.AllowAutoHide="False"
                             AutomationProperties.Name="Liste des étapes de la chaîne">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ChainStep">
                                <Border Padding="2,4">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="3">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <Border Grid.Column="0"
                                                    IsVisible="{Binding !IsReturnOnlyStep}"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Method, Converter={x:Static conv:HttpMethodConverters.ToUpper}}"
                                                           Classes="httpMethod"
                                                           Classes.get="{Binding Method, Converter={x:Static conv:HttpMethodConverters.IsGet}}"
                                                           Classes.post="{Binding Method, Converter={x:Static conv:HttpMethodConverters.IsPost}}"
                                                           Classes.put="{Binding Method, Converter={x:Static conv:HttpMethodConverters.IsPutOrPatch}}"
                                                           Classes.delete="{Binding Method, Converter={x:Static conv:HttpMethodConverters.IsDelete}}" />
                                            </Border>

                                            <Border Grid.Column="0"
                                                    IsVisible="{Binding IsReturnOnlyStep}"
                                                    Background="{DynamicResource SuccessSoftBrush}"
                                                    CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="RET"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SuccessBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StepHeaderLabel}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding StepHeaderLabel}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="2"
                                                    IsVisible="{Binding IsLooping}"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IterationsBadgeText}"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StepMetaSummaryText}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextFaintBrush}"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button Classes="icon"
                                                        Command="{Binding #ChainRoot.ViewModel.MoveStepUpCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Monter l'étape"
                                                        AutomationProperties.Name="{Binding MoveUpAutomationName}">
                                                    <Path Classes="iconStroke" Data="{StaticResource IconArrowUp}" />
                                                </Button>
                                                <Button Classes="icon"
                                                        Command="{Binding #ChainRoot.ViewModel.MoveStepDownCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Descendre l'étape"
                                                        AutomationProperties.Name="{Binding MoveDownAutomationName}">
                                                    <Path Classes="iconStroke" Data="{StaticResource IconArrowDown}" />
                                                </Button>
                                                <Button Classes="icon"
                                                        Command="{Binding #ChainRoot.ViewModel.DuplicateStepCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Dupliquer l'étape"
                                                        AutomationProperties.Name="Dupliquer l'étape">
                                                    <Path Classes="iconStroke" Data="{StaticResource IconCopy}" />
                                                </Button>
                                                <Button Classes="icon danger"
                                                        Command="{Binding #ChainRoot.ViewModel.RemoveStepCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Supprimer l'étape"
                                                        AutomationProperties.Name="Supprimer l'étape">
                                                    <Path Classes="iconStroke" Data="{StaticResource IconTrash}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Classes="vertical"
                          ResizeDirection="Columns" />

            <!-- Colonne droite : Éditeur de l'étape sélectionnée -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Padding="10">
                <Panel>
                    <TextBlock IsVisible="{Binding !HasSelectedStep}"
                               Text="Sélectionne ou ajoute une étape à gauche."
                               FontSize="{DynamicResource FontSizeBase}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Panel IsVisible="{Binding HasSelectedStep}">
                        <Panel DataContext="{Binding SelectedStep}">
                            <Panel x:DataType="models:ChainStep">
                            <!-- État initial : grand champ curl occupant toute la zone + 2 boutons -->
                            <Grid IsVisible="{Binding !HasParsed}"
                                  RowDefinitions="Auto,Auto,*,Auto"
                                  RowSpacing="8">
                                <Grid Grid.Row="0" ColumnDefinitions="200,*" ColumnSpacing="10">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Name}"
                                             PlaceholderText="Nom de l'étape"
                                             AutomationProperties.Name="Nom de l'étape" />
                                    <TextBlock Grid.Column="1"
                                               Text="Colle une commande curl ci-dessous, puis analyse-la ou bascule en mode manuel."
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Border Grid.Row="1"
                                        IsVisible="{Binding HasWarnings}"
                                        Background="{DynamicResource WarningSoftBrush}"
                                        BorderBrush="{DynamicResource WarningBorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Expander Classes="warningExpander" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="iconStroke"
                                                      Data="{StaticResource IconWarning}"
                                                      Stroke="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="{Binding WarningsSummaryText}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="200"
                                                      AllowAutoHide="False"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="26,0,12,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="{DynamicResource WarningBrush}"
                                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                                   TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Expander>
                                </Border>

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Grid.Column="0"
                                             Classes="mono"
                                             Text="{Binding CurlText}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             PlaceholderText="Colle ici une commande curl pour cette étape..."
                                             AutomationProperties.Name="Commande curl de l'étape" />

                                    <Button Grid.Column="1"
                                            Classes="icon"
                                            VerticalAlignment="Top"
                                            Command="{Binding #ChainRoot.ViewModel.EnlargeStepCurlCommand}"
                                            ToolTip.Tip="Agrandir"
                                            AutomationProperties.Name="Agrandir la commande curl de l'étape">
                                        <Path Classes="iconStroke" Data="{StaticResource IconExpand}" />
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Spacing="8">
                                    <Button Classes="primary"
                                            Content="Analyser"
                                            Command="{Binding #ChainRoot.ViewModel.ParseStepCurlCommand}"
                                            AutomationProperties.Name="Analyser la commande curl de l'étape" />

                                    <Button Classes="secondary"
                                            Content="Basculer en manuel"
                                            Command="{Binding #ChainRoot.ViewModel.InitManualStepCommand}"
                                            ToolTip.Tip="Configurer cette étape manuellement sans commande curl"
                                            AutomationProperties.Name="Configurer l'étape manuellement" />
                                </StackPanel>
                            </Grid>

                            <!-- État configuré (après analyse curl ou bascule manuelle) -->
                            <Grid IsVisible="{Binding HasParsed}"
                                  RowDefinitions="Auto,Auto,Auto,*"
                                  RowSpacing="6">

                        <!-- Nom + import curl compact -->
                        <Grid Grid.Row="0" ColumnDefinitions="200,*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding Name}"
                                     PlaceholderText="Nom de l'étape"
                                     AutomationProperties.Name="Nom de l'étape" />

                            <TextBox Grid.Column="1"
                                     Classes="mono"
                                     Text="{Binding CurlText}"
                                     AcceptsReturn="True"
                                     Height="32"
                                     MaxHeight="72"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="Colle une commande curl pour cette étape..."
                                     AutomationProperties.Name="Commande curl de l'étape" />

                            <Button Grid.Column="2"
                                    Classes="icon"
                                    VerticalAlignment="Center"
                                    Command="{Binding #ChainRoot.ViewModel.EnlargeStepCurlCommand}"
                                    ToolTip.Tip="Agrandir"
                                    AutomationProperties.Name="Agrandir la commande curl de l'étape">
                                <Path Classes="iconStroke" Data="{StaticResource IconExpand}" />
                            </Button>

                            <Button Grid.Column="3"
                                    Classes="primary"
                                    Content="Analyser"
                                    Command="{Binding #ChainRoot.ViewModel.ParseStepCurlCommand}"
                                    AutomationProperties.Name="Analyser la commande curl de l'étape" />
                        </Grid>

                        <!-- Avertissements parse curl -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding HasWarnings}"
                                Background="{DynamicResource WarningSoftBrush}"
                                BorderBrush="{DynamicResource WarningBorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Expander Classes="warningExpander" IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="iconStroke"
                                              Data="{StaticResource IconWarning}"
                                              Stroke="{DynamicResource WarningBrush}" />
                                        <TextBlock Text="{Binding WarningsSummaryText}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                    </StackPanel>
                                </Expander.Header>
                                <ScrollViewer MaxHeight="240"
                                              AllowAutoHide="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="26,0,12,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>
                        </Border>

                        <!-- Méthode + URL éditable -->
                        <Grid Grid.Row="2" ColumnDefinitions="110,*" ColumnSpacing="8">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{x:Static vm:ChainViewModel.HttpMethods}"
                                      SelectedItem="{Binding Method}"
                                      AutomationProperties.Name="Méthode HTTP de l'étape" />

                            <TextBox Grid.Column="1"
                                     Classes="mono"
                                     Text="{Binding Url}"
                                     PlaceholderText="https://api.exemple.com/endpoint (optionnel si Retour est défini ; accepte {{variables}} et [[listes]])"
                                     ToolTip.Tip="{Binding Url, Converter={x:Static conv:StringDisplayConverters.EmptyToNull}}"
                                     AutomationProperties.Name="URL de l'étape" />
                        </Grid>

                        <!-- Onglets de configuration de l'étape -->
                        <TabControl Grid.Row="3" Classes="sub">
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Paramètres" VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding VaryingParams.Count, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                Padding="5,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VaryingParams.Count}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <views:VaryingParamEditor Margin="0,6,0,0"
                                                          Items="{Binding VaryingParams}"
                                                          AddCommand="{Binding #ChainRoot.ViewModel.AddStepVaryingParamCommand}"
                                                          RemoveCommand="{Binding #ChainRoot.ViewModel.RemoveStepVaryingParamCommand}" />
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="En-têtes" VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding Headers.Count, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                Padding="5,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Headers.Count}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <views:KeyValueEditor Margin="0,6,0,0"
                                                      Items="{Binding Headers}"
                                                      AddCommand="{Binding #ChainRoot.ViewModel.AddStepHeaderCommand}"
                                                      RemoveCommand="{Binding #ChainRoot.ViewModel.RemoveStepHeaderCommand}"
                                                      EnableCookieEditor="True"
                                                      EditCookieCommand="{Binding #ChainRoot.ViewModel.EditCookieHeaderCommand}"
                                                      AddButtonText="Ajouter un en-tête"
                                                      KeyPlaceholder="Nom de l'en-tête"
                                                      ValuePlaceholder="Valeur (ex. Bearer {{token}})" />
                            </TabItem>

                            <TabItem Header="Corps">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6" Margin="0,6,0,0">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Type de corps"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{x:Static vm:ChainViewModel.BodyTypes}"
                                                      SelectedItem="{Binding BodyType}"
                                                      MinWidth="150"
                                                      AutomationProperties.Name="Type de corps de l'étape" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Classes="icon"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsBodyNotNone}"
                                                Command="{Binding #ChainRoot.ViewModel.EnlargeStepBodyCommand}"
                                                ToolTip.Tip="Agrandir"
                                                AutomationProperties.Name="Agrandir le corps de la requête de l'étape">
                                            <Path Classes="iconStroke" Data="{StaticResource IconExpand}" />
                                        </Button>
                                    </Grid>

                                    <TextBox Grid.Row="1"
                                             IsVisible="{Binding !IsFormBody}"
                                             Classes="mono"
                                             Text="{Binding Body}"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             PlaceholderText="Corps JSON ou texte (accepte {{variables}} et [[listes]])..."
                                             AutomationProperties.Name="Corps de la requête de l'étape" />

                                    <views:KeyValueEditor Grid.Row="1"
                                                          IsVisible="{Binding IsFormBody}"
                                                          Items="{Binding FormFields}"
                                                          AddCommand="{Binding #ChainRoot.ViewModel.AddStepFormFieldCommand}"
                                                          RemoveCommand="{Binding #ChainRoot.ViewModel.RemoveStepFormFieldCommand}"
                                                          AddButtonText="Ajouter un champ"
                                                          KeyPlaceholder="Champ"
                                                          ValuePlaceholder="Valeur" />

                                    <TextBlock Grid.Row="2"
                                               Text="Utilise {{nom}} pour une variable simple ou [[nom]] pour itérer sur une liste extraite."
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextFaintBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Variables" VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding UsedVariablesCount, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                Padding="5,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UsedVariablesCount}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6" Margin="0,6,0,0">
                                    <TextBlock Grid.Row="0"
                                               IsVisible="{Binding #ChainRoot.ViewModel.HasAvailableExtractedVariables}"
                                               Text="{Binding #ChainRoot.ViewModel.AvailableExtractedVariablesText}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1"
                                               IsVisible="{Binding HasUsedExtractedLists}"
                                               Text="{Binding UsedExtractedListsText}"
                                               FontFamily="{DynamicResource MonoFontFamily}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />

                                    <views:BatchVariableEditor Grid.Row="2"
                                                               Items="{Binding Variables}"
                                                               EnlargeListCommand="{Binding #ChainRoot.ViewModel.EnlargeVariableListCommand}" />

                                    <TextBlock Grid.Row="3"
                                               IsVisible="{Binding HasVariablesError}"
                                               Text="{Binding VariablesError}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Extractions" VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding Extractions.Count, Converter={x:Static conv:CollectionCountConverters.IsPositive}}"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                Padding="5,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Extractions.Count}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <views:ChainExtractionEditor Margin="0,6,0,0"
                                                             Items="{Binding Extractions}"
                                                             AddCommand="{Binding #ChainRoot.ViewModel.AddExtractionCommand}"
                                                             RemoveCommand="{Binding #ChainRoot.ViewModel.RemoveExtractionCommand}"
                                                             TestCommand="{Binding #ChainRoot.ViewModel.TestExtractionCommand}"
                                                             InspectListCommand="{Binding #ChainRoot.ViewModel.InspectExtractedListCommand}"
                                                             HasLastResponse="{Binding HasLastResponse}"
                                                             LastResponseSummary="{Binding LastResponseSummary}"
                                                             LastResponse="{Binding LastResponse}"
                                                             ExtractionSuggester="{Binding #ChainRoot.ViewModel.ExtractionSuggester}"
                                                             SourceVariablesProvider="{Binding #ChainRoot.ViewModel.GetSourceVariableSuggestionsFunc}"
                                                             SuggestionResponseResolver="{Binding #ChainRoot.ViewModel.GetSuggestionResponseFunc}" />
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Retour" VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding HasReturnExpression}"
                                                Background="{DynamicResource SuccessSoftBrush}"
                                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                Padding="5,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="actif"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessBrush}" />
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="6" Margin="0,6,0,0">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   Text="Valeur retournée par cette étape (variables simples, listes, objets JSON ou listes personnalisées). Laisse l'URL vide pour créer une étape de retour pur."
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="1"
                                                Classes="secondary"
                                                Content="Tester"
                                                Command="{Binding #ChainRoot.ViewModel.TestStepReturnCommand}"
                                                ToolTip.Tip="Évaluer l'expression de retour avec les dernières variables disponibles"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Tester l'expression de retour" />

                                        <Button Grid.Column="2"
                                                Classes="icon"
                                                Command="{Binding #ChainRoot.ViewModel.EnlargeStepReturnCommand}"
                                                ToolTip.Tip="Agrandir"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Agrandir l'expression de retour">
                                            <Path Classes="iconStroke" Data="{StaticResource IconExpand}" />
                                        </Button>
                                    </Grid>

                                    <TextBox Grid.Row="1"
                                             Classes="mono"
                                             Text="{Binding ReturnExpression}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             PlaceholderText="Exemples :&#x0A;return nom_variable&#x0A;return ip&#x0A;return { ip, token: token, ids: [[ids]], label: &quot;Bearer {{token}}&quot; }"
                                             AutomationProperties.Name="Expression de retour de l'étape" />

                                    <TextBlock Grid.Row="2"
                                               IsVisible="{Binding HasReturnError}"
                                               Text="{Binding ReturnError}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               TextWrapping="Wrap" />

                                    <Border Grid.Row="3"
                                            IsVisible="{Binding HasLastReturnValue}"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="8,4">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding LastReturnPreviewText, StringFormat='Retour : {0}'}"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <Button Grid.Column="1"
                                                    Classes="ghost"
                                                    Content="Copier"
                                                    Command="{Binding #ChainRoot.ViewModel.CopyStepReturnCommand}"
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    Height="22"
                                                    MinHeight="22"
                                                    Padding="8,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Copier la dernière valeur retournée" />

                                            <Button Grid.Column="2"
                                                    Classes="ghost"
                                                    Content="Voir"
                                                    Command="{Binding #ChainRoot.ViewModel.InspectStepReturnCommand}"
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    Height="22"
                                                    MinHeight="22"
                                                    Padding="8,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Afficher toute la valeur retournée" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="4"
                                               Text="Syntaxes : return var · return ip · return a, b · { cle: val, shorthand } · [a, b, liste] · &quot;texte {{var}}&quot; · &quot;a&quot; + var"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextFaintBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </TabItem>

                            <TabItem Header="Options">
                                <ScrollViewer Margin="0,6,0,0"
                                              AllowAutoHide="False"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="10" Margin="0,0,12,4">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4" VerticalAlignment="Center">
                                                <TextBlock Text="Délai après cette étape (ms)"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding DelayAfterMs, Converter={x:Static conv:ChainDelayMsToDecimalConverter.Instance}, Mode=TwoWay}"
                                                               Minimum="0"
                                                               Maximum="60000"
                                                               Increment="100"
                                                               FormatString="0"
                                                               Width="140"
                                                               AutomationProperties.Name="Délai après l'étape en millisecondes" />
                                            </StackPanel>

                                            <CheckBox IsChecked="{Binding ContinueOnError}"
                                                      Content="Continuer la chaîne si cette étape échoue"
                                                      Margin="0,0,16,4"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Continuer en cas d'erreur" />

                                            <CheckBox IsChecked="{Binding StepRateLimitUsesGlobalPolicy}"
                                                      Content="Appliquer la politique globale de rate limit"
                                                      Margin="0,0,0,4"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="Appliquer la politique globale de rate limit" />
                                        </WrapPanel>

                                        <StackPanel IsVisible="{Binding HasMultipleAxes}" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Mode de boucle de l'étape"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <ComboBox ItemsSource="{x:Static vm:ChainViewModel.BatchModes}"
                                                          SelectedItem="{Binding SelectedMode}"
                                                          MinWidth="148"
                                                          AutomationProperties.Name="Mode de boucle de l'étape">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BatchMode">
                                                            <TextBlock Text="{Binding Converter={x:Static conv:BatchModeConverters.ToLabel}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Axes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:BatchAxis">
                                                        <Border Classes="kvRow"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="6,3">
                                                            <Grid ColumnDefinitions="24,*,Auto,Auto" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Rank}"
                                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding DisplayName}"
                                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding ValueCountText}"
                                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                                                                    <Button Classes="icon"
                                                                            Command="{Binding #ChainRoot.ViewModel.MoveStepAxisUpCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="Monter l'axe"
                                                                            AutomationProperties.Name="{Binding MoveUpAutomationName}">
                                                                        <Path Classes="iconStroke" Data="{StaticResource IconArrowUp}" />
                                                                    </Button>
                                                                    <Button Classes="icon"
                                                                            Command="{Binding #ChainRoot.ViewModel.MoveStepAxisDownCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="Descendre l'axe"
                                                                            AutomationProperties.Name="{Binding MoveDownAutomationName}">
                                                                        <Path Classes="iconStroke" Data="{StaticResource IconArrowDown}" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                            </Grid>
                            </Panel>
                        </Panel>
                    </Panel>
                </Panel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1"
                      Classes="horizontal"
                      ResizeDirection="Rows" />

        <!-- BAS : Barre d'exécution + Sections repliables + Résultats & Réponse -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
            <!-- Barre de contrôle de la chaîne -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Padding="10,8">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding KeepBodies}"
                                      Content="Conserver les corps"
                                      Margin="0,0,14,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Conserver les corps des réponses" />

                            <CheckBox IsChecked="{Binding GlobalRateLimitPolicy.IsEnabled}"
                                      IsEnabled="{Binding !IsRunning}"
                                      Content="Politique globale de rate limit"
                                      Margin="0,0,14,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Activer la politique globale de rate limit" />

                            <CheckBox IsVisible="{Binding NeedsConfirmation}"
                                      IsChecked="{Binding IsConfirmed}"
                                      Content="Confirmer (> 500 requêtes)"
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Confirmer le lancement de plus de 500 requêtes" />
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{x:Static vm:ChainViewModel.CliLanguages}"
                                      SelectedItem="{Binding SelectedCliLanguage}"
                                      MinWidth="112"
                                      AutomationProperties.Name="Langage du script CLI à générer">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChainCliLanguage">
                                        <TextBlock Text="{Binding Converter={x:Static conv:ChainCliLanguageConverters.ToLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Classes="secondary"
                                    Command="{Binding GenerateCliCommand}"
                                    ToolTip.Tip="Générer un script CLI exécutable pour cette chaîne"
                                    AutomationProperties.Name="Générer le script CLI de la chaîne">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="iconStroke" Data="{StaticResource IconCode}" />
                                    <TextBlock Text="Générer CLI" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="secondary"
                                    Command="{Binding SavePipelineCommand}"
                                    ToolTip.Tip="Enregistrer le pipeline dans un fichier .apit"
                                    AutomationProperties.Name="Enregistrer le pipeline au format .apit">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="iconStroke" Data="{StaticResource IconSave}" />
                                    <TextBlock Text="Enregistrer .apit" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding TotalRequestsText}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />

                            <Panel VerticalAlignment="Center">
                                <Button Classes="primary"
                                        Command="{Binding RunCommand}"
                                        IsVisible="{Binding !IsRunning}"
                                        MinWidth="132"
                                        AutomationProperties.Name="Lancer la chaîne">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="iconStroke" Data="{StaticResource IconSend}" />
                                        <TextBlock Text="Lancer la chaîne" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="secondary"
                                        Command="{Binding RunCancelCommand}"
                                        IsVisible="{Binding IsRunning}"
                                        MinWidth="132"
                                        AutomationProperties.Name="Annuler la chaîne">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="iconStroke" Data="{StaticResource IconStop}" />
                                        <TextBlock Text="Annuler" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Panel>
                        </StackPanel>
                    </Grid>

                    <TextBlock IsVisible="{Binding HasPipelineSaveError}"
                               Text="{Binding PipelineSaveError}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock IsVisible="{Binding HasPipelineSaveStatus}"
                               Text="{Binding PipelineSaveStatusText}"
                               ToolTip.Tip="{Binding LastSavedPipelinePath}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource SuccessBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock IsVisible="{Binding HasPlanError}"
                               Text="{Binding PlanError}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />

                    <!-- Avertissements chaîne -->
                    <Border IsVisible="{Binding HasChainWarnings}"
                            Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Expander Classes="warningExpander" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="iconStroke"
                                          Data="{StaticResource IconWarning}"
                                          Stroke="{DynamicResource WarningBrush}" />
                                    <TextBlock Text="{Binding ChainWarnings.Count, StringFormat='{}{0} avertissement(s) sur la chaîne'}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <ScrollViewer MaxHeight="240"
                                          AllowAutoHide="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ChainWarnings}" Margin="26,0,12,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </Border>

                    <!-- Enregistrement des réponses (replié par défaut) -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,4,0,0">
                        <Expander Classes="sectionExpander" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Enregistrement des réponses sur disque"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Expander.Header>
                            <StackPanel IsEnabled="{Binding !IsRunning}" Spacing="6" Margin="0,6,0,2">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{x:Static vm:ChainViewModel.SaveModes}"
                                              SelectedItem="{Binding SaveMode}"
                                              MinWidth="190"
                                              Margin="0,0,12,0"
                                              AutomationProperties.Name="Mode d'enregistrement de la chaîne">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SaveMode">
                                                <TextBlock Text="{Binding Converter={x:Static conv:SaveModeConverters.ToLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <CheckBox IsVisible="{Binding CanChooseFolder}"
                                              IsChecked="{Binding CreateTimestampSubfolder}"
                                              Content="Sous-dossier horodaté"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Créer un sous-dossier horodaté" />

                                    <CheckBox IsVisible="{Binding ShowPerRequestOptions}"
                                              IsChecked="{Binding IncludeSummaryCsv}"
                                              Content="Inclure _resume.csv"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Inclure _resume.csv" />

                                    <ComboBox IsVisible="{Binding ShowGroupedOptions}"
                                              ItemsSource="{x:Static vm:ChainViewModel.GroupedFormats}"
                                              SelectedItem="{Binding GroupedFormat}"
                                              MinWidth="210"
                                              AutomationProperties.Name="Format groupé de la chaîne">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:GroupedFormat">
                                                <TextBlock Text="{Binding Converter={x:Static conv:GroupedFormatConverters.ToLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </WrapPanel>

                                <Grid IsVisible="{Binding CanChooseFolder}"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Classes="mono"
                                             Text="{Binding OutputFolder}"
                                             PlaceholderText="Dossier de destination"
                                             AutomationProperties.Name="Dossier d'enregistrement de la chaîne" />
                                    <Button Grid.Column="1"
                                            Classes="secondary"
                                            Command="{Binding BrowseFolderCommand}"
                                            AutomationProperties.Name="Choisir le dossier d'enregistrement">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="iconStroke" Data="{StaticResource IconFolder}" />
                                            <TextBlock Text="Choisir…" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock IsVisible="{Binding HasSaveError}"
                                           Text="{Binding SaveError}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" />

                                <StackPanel IsVisible="{Binding HasSaveSummary}"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SaveSummaryText}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               VerticalAlignment="Center" />
                                    <Button Classes="secondary"
                                            Content="Ouvrir le dossier"
                                            Command="{Binding OpenOutputFolderCommand}"
                                            AutomationProperties.Name="Ouvrir le dossier d'enregistrement" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Résultats + Variables déclarées à gauche | ResponseView à droite -->
            <Grid Grid.Row="1" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" MinWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0.85*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="0.95*" MinWidth="140" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="{DynamicResource PanelCornerRadius}"
                            Padding="10">
                        <Grid RowDefinitions="Auto,*" RowSpacing="6">
                        <StackPanel Grid.Row="0" IsVisible="{Binding HasChainStats}" Spacing="4">
                            <Grid IsVisible="{Binding IsRunning}"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <ProgressBar Grid.Column="0"
                                             Minimum="0"
                                             Maximum="{Binding ProgressTotal}"
                                             Value="{Binding ProgressCurrent}"
                                             Height="2"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Progression de la chaîne" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressText}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <WrapPanel Grid.Column="0"
                                           Orientation="Horizontal"
                                           VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ChainStatsSummaryText}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,10,0" />
                                    <TextBlock IsVisible="{Binding HasFinalStatusText}"
                                               Text="{Binding FinalStatusText}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextBrush}" />
                                </WrapPanel>

                                <ComboBox Grid.Column="1"
                                          IsVisible="{Binding HasResults}"
                                          ItemsSource="{x:Static vm:ChainViewModel.ResultSortModes}"
                                          SelectedItem="{Binding SelectedResultSortMode}"
                                          Height="24"
                                          MinHeight="24"
                                          MinWidth="125"
                                          Padding="8,1"
                                          FontSize="{DynamicResource FontSizeCaption}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Trier les résultats"
                                          AutomationProperties.Name="Trier les résultats de la chaîne">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChainResultSortMode">
                                            <TextBlock Text="{Binding Converter={x:Static conv:ChainResultSortModeConverters.ToLabel}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   IsVisible="{Binding !HasResults}"
                                   Text="Configure tes étapes puis clique sur « Lancer la chaîne »."
                                   FontSize="{DynamicResource FontSizeBase}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <ListBox Grid.Row="1"
                                 IsVisible="{Binding HasResults}"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult}"
                                 ScrollViewer.AllowAutoHide="False"
                                 AutomationProperties.Name="Résultats de la chaîne">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ChainStepResult">
                                    <Border Background="Transparent">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copier en cURL"
                                                          IsEnabled="{Binding CanCopyAsCurl}"
                                                          Click="OnCopyResultAsCurlMenuItemClick">
                                                    <MenuItem.Icon>
                                                        <Path Classes="iconStroke" Data="{StaticResource IconCopy}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <StackPanel Spacing="2" Margin="0,2,8,2">
                                            <Grid ColumnDefinitions="*,Auto,Auto,60" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding StepIterationLabel}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding RequestSummary}"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="1"
                                                        Classes="chainStatusPill"
                                                        Classes.success="{Binding IsSuccessStatus}"
                                                        Classes.failed="{Binding IsFailedStatus}"
                                                        Classes.skipped="{Binding IsSkippedStatus}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Classes="chainDot"
                                                                 Width="6"
                                                                 Height="6"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock IsVisible="{Binding WasRateLimited}"
                                                                   Text="{Binding RateLimitSuffixText}"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SizeKbText}"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DurationMs, StringFormat='{}{0} ms'}"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="{DynamicResource FontSizeSmall}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <TextBlock IsVisible="{Binding HasExtractedSummary}"
                                                       Text="{Binding ExtractedSummaryText}"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock IsVisible="{Binding HasReturnValue}"
                                                       Text="{Binding ReturnPreviewText}"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ReturnValue}" />

                                            <TextBlock IsVisible="{Binding HasErrorMessage}"
                                                       Text="{Binding ErrorMessage}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ErrorMessage}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                    <GridSplitter Grid.Column="1"
                                  Classes="vertical"
                                  ResizeDirection="Columns" />

                    <!-- Liste verticale des variables déclarées avec dropdown -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="{DynamicResource PanelCornerRadius}"
                            Padding="10">
                        <Grid RowDefinitions="Auto,*" RowSpacing="6">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           Text="Variables déclarées"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        IsVisible="{Binding HasDeclaredVariables}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="{DynamicResource BadgeCornerRadius}"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeclaredVariables.Count}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       IsVisible="{Binding !HasDeclaredVariables}"
                                       Text="Aucune variable déclarée."
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />

                            <ScrollViewer Grid.Row="1"
                                          IsVisible="{Binding HasDeclaredVariables}"
                                          AllowAutoHide="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding DeclaredVariables}" Margin="0,0,4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChainDeclaredVariableItem">
                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,2"
                                                    Margin="0,0,0,4">
                                                <Expander Classes="sectionExpander"
                                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                    <Expander.Header>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding TokenName}"
                                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding TokenName}"
                                                                       VerticalAlignment="Center" />
                                                            <Border Grid.Column="1"
                                                                    Background="{DynamicResource SurfaceBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                                    Padding="5,1"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SourceBadge}"
                                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Expander.Header>

                                                    <StackPanel Spacing="6" Margin="0,4,0,6">
                                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                                Padding="8,6">
                                                            <ScrollViewer MaxHeight="140"
                                                                          AllowAutoHide="False"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Auto">
                                                                <SelectableTextBlock Text="{Binding ContentText}"
                                                                                     Classes.varPending="{Binding !HasValue}"
                                                                                     FontFamily="{DynamicResource MonoFontFamily}"
                                                                                     FontSize="{DynamicResource FontSizeCaption}"
                                                                                     TextWrapping="Wrap" />
                                                            </ScrollViewer>
                                                        </Border>

                                                        <StackPanel IsVisible="{Binding CanCopyOrInspect}"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Spacing="4">
                                                            <Button Classes="ghost"
                                                                    Content="Copier"
                                                                    Command="{Binding #ChainRoot.ViewModel.CopyDeclaredVariableCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                                    Height="22"
                                                                    MinHeight="22"
                                                                    Padding="8,0"
                                                                    AutomationProperties.Name="Copier le contenu de la variable" />
                                                            <Button Classes="ghost"
                                                                    Content="Voir"
                                                                    Command="{Binding #ChainRoot.ViewModel.InspectDeclaredVariableCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                                    Height="22"
                                                                    MinHeight="22"
                                                                    Padding="8,0"
                                                                    AutomationProperties.Name="Afficher tout le contenu de la variable" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1"
                              Classes="vertical"
                              ResizeDirection="Columns" />

                <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="6">
                    <Border Grid.Row="0"
                            IsVisible="{Binding HasSelectedReturnValue}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="10,6">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Text="Retour :"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedReturnPreviewText}"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Classes="ghost"
                                    Content="Copier"
                                    Command="{Binding CopySelectedReturnCommand}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Height="24"
                                    MinHeight="24"
                                    Padding="8,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Copier le retour sélectionné" />
                            <Button Grid.Column="3"
                                    Classes="ghost"
                                    Content="Voir"
                                    Command="{Binding InspectSelectedReturnCommand}"
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    Height="24"
                                    MinHeight="24"
                                    Padding="8,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Afficher tout le retour sélectionné" />
                        </Grid>
                    </Border>

                    <views:ResponseView Grid.Row="1"
                                        DataContext="{Binding SelectedResponse}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
