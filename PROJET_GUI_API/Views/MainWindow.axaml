<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApiTester.ViewModels"
        xmlns:views="using:ApiTester.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        Width="1120" Height="720"
        MinWidth="900" MinHeight="600"
        x:Class="ApiTester.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        Icon="/Assets/avalonia-logo.ico"
        Title="ApiTester">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape"
                    Command="{Binding CloseActiveOverlayCommand}" />
    </Window.KeyBindings>

    <Grid x:Name="RootDropGrid" DragDrop.AllowDrop="True">
        <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                    Padding="12">
            <TabItem Header="Requête">
                <views:SingleRequestView DataContext="{Binding SingleRequest}" />
            </TabItem>

            <TabItem Header="Lot (curl)">
                <views:BatchView DataContext="{Binding Batch}" />
            </TabItem>

            <TabItem Header="Chaîne">
                <views:ChainView DataContext="{Binding Chain}" />
            </TabItem>

            <TabItem Header="Extracteur">
                <views:ExtractorView DataContext="{Binding Extractor}" />
            </TabItem>
        </TabControl>

        <!-- Éditeur plein écran superposé dans la fenêtre principale -->
        <Grid x:Name="OverlayScrim"
              IsVisible="{Binding Overlay.IsOpen}"
              Background="{DynamicResource ScrimBrush}"
              PointerPressed="OnOverlayScrimPointerPressed">
            <Grid RowDefinitions="*,18*,*"
                  ColumnDefinitions="*,18*,*">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PanelCornerRadius}"
                        Padding="14"
                        PointerPressed="OnOverlayCardPointerPressed">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <!-- En-tête : titre + Indenter le JSON + Conditions + Copier + Fermer -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Overlay.Title}"
                                       FontSize="{DynamicResource FontSizeBase}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Content="Indenter le JSON"
                                    IsVisible="{Binding Overlay.IsValidJson}"
                                    Command="{Binding Overlay.FormatJsonCommand}"
                                    AutomationProperties.Name="Indenter le JSON" />

                            <Button Grid.Column="2"
                                    Classes.primary="{Binding Overlay.IsConditionsOpen}"
                                    Classes.secondary="{Binding !Overlay.IsConditionsOpen}"
                                    IsVisible="{Binding Overlay.HasConditionsSupport}"
                                    Command="{Binding Overlay.ToggleConditionsCommand}"
                                    ToolTip.Tip="Diviser l'écran et affiner l'extraction par conditions (Regex, filtres, mode manuel)"
                                    AutomationProperties.Name="Conditions d'extraction">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Conditions" VerticalAlignment="Center" />
                                    <Border IsVisible="{Binding Overlay.HasActiveConditionsBadge}"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="{DynamicResource BadgeCornerRadius}"
                                            Padding="5,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Overlay.ActiveConditionsCount}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3"
                                    Classes="ghost"
                                    Command="{Binding Overlay.CopyCommand}"
                                    AutomationProperties.Name="Copier le contenu">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="iconStroke" Data="{StaticResource IconCopy}" />
                                    <TextBlock Text="Copier" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4"
                                    Classes="icon"
                                    Command="{Binding Overlay.CloseCommand}"
                                    ToolTip.Tip="Fermer (Échap)"
                                    AutomationProperties.Name="Fermer l'éditeur">
                                <Path Classes="iconStroke" Data="{StaticResource IconClose}" />
                            </Button>
                        </Grid>

                        <!-- Corps : pleine largeur ou divisé en deux avec Conditions à droite -->
                        <Grid x:Name="OverlayBodyGrid"
                              Grid.Row="1"
                              ColumnDefinitions="*,0,0">
                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="6">
                                <Border Grid.Row="0"
                                        IsVisible="{Binding Overlay.HasConditionsSupport}"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="8,4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Overlay.ConditionFilterSummaryText}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   IsVisible="{Binding Overlay.HasConditionFilterError}"
                                                   Text="{Binding Overlay.ConditionFilterError}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <TextBox x:Name="OverlayEditorTextBox"
                                         Grid.Row="1"
                                         Classes="mono"
                                         Text="{Binding Overlay.Text, Mode=TwoWay}"
                                         IsReadOnly="{Binding Overlay.IsReadOnly}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontSize="{DynamicResource FontSizeMono}"
                                         ScrollViewer.AllowAutoHide="False"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Contenu de l'éditeur agrandi" />
                            </Grid>

                            <GridSplitter x:Name="OverlayConditionsSplitter"
                                          Grid.Column="1"
                                          Classes="vertical"
                                          ResizeDirection="Columns"
                                          Margin="4,0"
                                          IsVisible="{Binding Overlay.IsConditionsOpen}" />

                            <Panel Grid.Column="2"
                                   IsVisible="{Binding Overlay.IsConditionsOpen}">
                                <views:ExtractionConditionsView x:Name="OverlayConditionsPanel"
                                                                DataContext="{Binding Overlay.ConditionsPanel}" />
                            </Panel>
                        </Grid>

                        <!-- Pied : Annuler / Enregistrer, Appliquer conditions, ou Fermer -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Classes="secondary"
                                    Content="Annuler"
                                    IsVisible="{Binding Overlay.ShowStandardSaveButtons}"
                                    Command="{Binding Overlay.CloseCommand}"
                                    AutomationProperties.Name="Annuler les modifications" />
                            <Button Classes="primary"
                                    Content="Enregistrer"
                                    IsVisible="{Binding Overlay.ShowStandardSaveButtons}"
                                    Command="{Binding Overlay.SaveAndCloseCommand}"
                                    AutomationProperties.Name="Enregistrer les modifications" />
                            <Button Classes="secondary"
                                    Content="Fermer"
                                    IsVisible="{Binding Overlay.ShowStandardCloseButton}"
                                    Command="{Binding Overlay.CloseCommand}"
                                    AutomationProperties.Name="Fermer l'éditeur" />

                            <Button Classes="secondary"
                                    Content="Annuler"
                                    IsVisible="{Binding Overlay.ShowConditionsApplyButtons}"
                                    Command="{Binding Overlay.CloseCommand}"
                                    AutomationProperties.Name="Annuler les conditions" />
                            <Button Classes="primary"
                                    Content="Appliquer"
                                    IsVisible="{Binding Overlay.ShowConditionsApplyButtons}"
                                    Command="{Binding Overlay.ApplyConditionsCommand}"
                                    AutomationProperties.Name="Appliquer les conditions d'extraction" />
                            <Button Classes="secondary"
                                    Content="Fermer"
                                    IsVisible="{Binding Overlay.ShowConditionsCloseButton}"
                                    Command="{Binding Overlay.CloseCommand}"
                                    AutomationProperties.Name="Fermer la liste extraite" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Éditeur de cookies en popup -->
        <Grid x:Name="CookieScrim"
              IsVisible="{Binding CookieEditor.IsOpen}"
              Background="{DynamicResource ScrimBrush}"
              PointerPressed="OnCookieScrimPointerPressed">
            <Grid RowDefinitions="*,18*,*"
                  ColumnDefinitions="*,20*,*">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PanelCornerRadius}"
                        Padding="14"
                        PointerPressed="OnOverlayCardPointerPressed">
                    <views:CookieEditorView DataContext="{Binding CookieEditor}" />
                </Border>
            </Grid>
        </Grid>
        <!-- Popup d'import de fichier HAR -->
        <Grid x:Name="HarImportScrim"
              IsVisible="{Binding HarImport.IsOpen}"
              Background="{DynamicResource ScrimBrush}"
              PointerPressed="OnHarImportScrimPointerPressed">
            <Grid RowDefinitions="*,22*,*"
                  ColumnDefinitions="*,24*,*">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PanelCornerRadius}"
                        Padding="14"
                        PointerPressed="OnOverlayCardPointerPressed">
                    <views:HarImportView DataContext="{Binding HarImport}" />
                </Border>
            </Grid>
        </Grid>

        <!-- Indicateur visuel lors du glisser-déposer d'un fichier .har -->
        <Grid x:Name="HarDropHintOverlay"
              IsVisible="False"
              IsHitTestVisible="False"
              Background="{DynamicResource ScrimBrush}">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource PanelCornerRadius}"
                    Padding="28,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Path Classes="iconStroke"
                          Width="28"
                          Height="28"
                          HorizontalAlignment="Center"
                          Stroke="{DynamicResource AccentBrush}"
                          Data="{StaticResource IconImport}" />
                    <TextBlock Text="Dépose le fichier .har pour importer les requêtes"
                               FontSize="{DynamicResource FontSizeBase}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Tu pourras sélectionner tout ou partie des requêtes à ajouter dans l'onglet Chaîne."
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
