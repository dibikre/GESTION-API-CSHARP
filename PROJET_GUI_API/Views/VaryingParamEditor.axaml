<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:ApiTester.Models"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="220"
             x:Class="ApiTester.Views.VaryingParamEditor"
             x:Name="Root"
             x:DataType="x:Object">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
        <!-- En-tête des colonnes -->
        <Grid Grid.Row="0"
              ColumnDefinitions="36,*,*,78,96,96,86,86"
              ColumnSpacing="6"
              Margin="4,0,4,0">
            <TextBlock Grid.Column="0" Text="Actif" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBlock Grid.Column="1" Text="Nom" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBlock Grid.Column="2" Text="Valeur" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBlock Grid.Column="3" Text="Varier" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBlock Grid.Column="4" Text="Début" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBlock Grid.Column="5" Text="Fin" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBlock Grid.Column="6" Text="Pas" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding #Root.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:VaryingParam">
                        <Grid ColumnDefinitions="36,*,*,78,96,96,86,86"
                              ColumnSpacing="6"
                              Margin="0,0,0,6">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsEnabled}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Activer le paramètre" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding Name}"
                                     PlaceholderText="Nom"
                                     AutomationProperties.Name="Nom du paramètre" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding Value}"
                                     PlaceholderText="Valeur fixe"
                                     AutomationProperties.Name="Valeur du paramètre" />

                            <CheckBox Grid.Column="3"
                                      IsChecked="{Binding IsVarying}"
                                      Content="Varier"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Faire varier ce paramètre" />

                            <NumericUpDown Grid.Column="4"
                                           Value="{Binding Start, Converter={x:Static conv:LongToDecimalConverter.Instance}, Mode=TwoWay}"
                                           IsEnabled="{Binding IsVarying}"
                                           FormatString="0"
                                           Increment="1"
                                           ShowButtonSpinner="False"
                                           AutomationProperties.Name="Valeur de début" />

                            <NumericUpDown Grid.Column="5"
                                           Value="{Binding End, Converter={x:Static conv:LongToDecimalConverter.Instance}, Mode=TwoWay}"
                                           IsEnabled="{Binding IsVarying}"
                                           FormatString="0"
                                           Increment="1"
                                           ShowButtonSpinner="False"
                                           AutomationProperties.Name="Valeur de fin" />

                            <NumericUpDown Grid.Column="6"
                                           Value="{Binding Step, Converter={x:Static conv:LongToDecimalConverter.Instance}, Mode=TwoWay}"
                                           IsEnabled="{Binding IsVarying}"
                                           FormatString="0"
                                           Increment="1"
                                           ShowButtonSpinner="False"
                                           AutomationProperties.Name="Pas" />

                            <Button Grid.Column="7"
                                    Content="Supprimer"
                                    Command="{Binding #Root.RemoveCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Supprimer le paramètre" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Ajouter un paramètre"
                    Command="{Binding #Root.AddCommand}"
                    AutomationProperties.Name="Ajouter un paramètre d'URL" />
        </StackPanel>
    </Grid>

</UserControl>
