<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApiTester.ViewModels"
             xmlns:models="using:ApiTester.Models"
             xmlns:conv="using:ApiTester.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="280"
             x:Class="ApiTester.Views.BatchOrderPanel"
             x:Name="Root"
             x:DataType="vm:BatchViewModel">

    <UserControl.Styles>
        <Style Selector="Border.roleBadge">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource BadgeCornerRadius}" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Border.roleBadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Border.roleBadge.outer">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.roleBadge.outer TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Border.roleBadge.inner">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>
        <Style Selector="Border.roleBadge.inner TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Border.orderCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource BadgeCornerRadius}" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Border.orderCell TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="Border.orderCell.changed">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Border.orderCell.changed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.icon TextBlock.orderArrow">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}">
        <Expander Classes="warningExpander" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Ordre des boucles"
                               FontSize="{DynamicResource FontSizeBase}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="{DynamicResource BadgeCornerRadius}"
                            Padding="5,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Axes.Count}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <Border IsVisible="{Binding IsOrderIgnored}"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource BadgeCornerRadius}"
                            Padding="5,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="ignoré en parallèle"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
            </Expander.Header>

            <StackPanel Margin="10,2,10,10" Spacing="8">
                <TextBlock Text="Le premier axe change le moins souvent. Le dernier change à chaque requête."
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />

                <!-- Notice discrète lorsque le mode En parallèle est sélectionné -->
                <Border IsVisible="{Binding IsOrderIgnored}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="iconStroke"
                              Data="{StaticResource IconInfo}"
                              Stroke="{DynamicResource TextMutedBrush}"
                              VerticalAlignment="Center" />
                        <TextBlock Text="L'ordre n'a pas d'effet en mode « En parallèle » : toutes les valeurs avancent ensemble."
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Liste ordonnée des axes -->
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                    <ItemsControl ItemsSource="{Binding Axes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BatchAxis">
                                <Border Classes="kvRow"
                                        MinHeight="28"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,2">
                                    <Grid ColumnDefinitions="24,*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource BadgeCornerRadius}"
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Rank}"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                   FontSize="{DynamicResource FontSizeMono}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding ValuesPreview, Converter={x:Static conv:StringDisplayConverters.EmptyToNull}}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ValueCountText}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="3"
                                                Classes="roleBadge"
                                                Classes.outer="{Binding IsOuterRole}"
                                                Classes.inner="{Binding IsInnerRole}"
                                                IsVisible="{Binding HasRoleText}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoleText}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       FontWeight="Medium" />
                                        </Border>

                                        <StackPanel Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    VerticalAlignment="Center">
                                            <Button Classes="icon"
                                                    Command="{Binding #Root.MoveUpCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Monter"
                                                    AutomationProperties.Name="{Binding MoveUpAutomationName}">
                                                <TextBlock Classes="orderArrow"
                                                           Text="▲"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                            <Button Classes="icon"
                                                    Command="{Binding #Root.MoveDownCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Descendre"
                                                    AutomationProperties.Name="{Binding MoveDownAutomationName}">
                                                <TextBlock Classes="orderArrow"
                                                           Text="▼"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Résumé dynamique de l'imbrication -->
                <TextBlock IsVisible="{Binding ShowOrderPanel}"
                           Text="{Binding OrderSummaryText}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />

                <!-- Mini-aperçu dynamique de l'ordre d'exécution -->
                <StackPanel IsVisible="{Binding ShowOrderPanel}" Spacing="4">
                    <StackPanel IsVisible="{Binding HasOrderPreview}" Spacing="4">
                        <TextBlock Text="Aperçu de l'ordre d'exécution"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextMutedBrush}" />

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="6,4">
                            <StackPanel Spacing="2">
                                <!-- En-tête de colonnes -->
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,12,4">
                                    <Grid ColumnDefinitions="44,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0"
                                                   Text="#"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Axes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:BatchAxis">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontFamily="{DynamicResource MonoFontFamily}"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Padding="6,0"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- 12 premières lignes -->
                                <ScrollViewer MaxHeight="200"
                                              AllowAutoHide="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding OrderPreview}" Margin="0,0,12,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:BatchOrderPreviewRow">
                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,2">
                                                    <Grid ColumnDefinitions="44,*" ColumnSpacing="6">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Index}"
                                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:BatchOrderPreviewCell">
                                                                    <Border Classes="orderCell"
                                                                            Classes.changed="{Binding HasChanged}"
                                                                            Margin="1,0"
                                                                            ToolTip.Tip="{Binding FullValue, Converter={x:Static conv:StringDisplayConverters.EmptyToNull}}">
                                                                        <TextBlock Text="{Binding DisplayValue}"
                                                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock IsVisible="{Binding HasOrderPreviewOverflow}"
                                           Text="{Binding OrderPreviewOverflowText}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextFaintBrush}"
                                           Margin="4,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Expander>
    </Border>

</UserControl>
